{%- comment -%}
  Boarage PDP · FAQ. Small green eyebrow, bold dark-green heading, then one accordion row per "Question"
  block (same row design as the accordion: bordered white card, title left, + / − right, rich-text answer).
  Rows come from snippets/boarage-accordion-item.liquid. Emits FAQPage JSON-LD for the filled rows.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign sid = section.id
  assign qas = section.blocks | where: 'type', 'qa'
  case s.heading_font_source
    when 'body'
      assign heading_font = 'var(--font-body-family, system-ui, sans-serif)'
    when 'custom'
      assign heading_font = s.heading_font.family | append: ', ' | append: s.heading_font.fallback_families
    else
      assign heading_font = 'var(--font-heading-family, system-ui, sans-serif)'
  endcase
  case s.body_font_source
    when 'heading'
      assign body_font = 'var(--font-heading-family, system-ui, sans-serif)'
    when 'custom'
      assign body_font = s.body_font.family | append: ', ' | append: s.body_font.fallback_families
    else
      assign body_font = 'var(--font-body-family, system-ui, sans-serif)'
  endcase
  assign line_height = s.line_height | times: 1.0 | divided_by: 100
  assign filled = 0
  for block in qas
    if block.settings.question != blank and block.settings.answer != blank
      assign filled = filled | plus: 1
    endif
  endfor
-%}
{%- if s.heading_font_source == 'custom' and s.heading_font != blank -%}
  {%- style -%}{{ s.heading_font | font_face: font_display: 'swap' }}{%- endstyle -%}
{%- endif -%}
{%- if s.body_font_source == 'custom' and s.body_font != blank -%}
  {%- style -%}{{ s.body_font | font_face: font_display: 'swap' }}{%- endstyle -%}
{%- endif -%}
{%- style -%}
  .bfq { box-sizing: border-box; padding: var(--bfq-pad-top, 48px) 0 var(--bfq-pad-bottom, 48px); background: var(--bfq-bg, #ffffff); -webkit-font-smoothing: antialiased; }
  .bfq__wrap { box-sizing: border-box; max-width: var(--bfq-max, 760px); margin: 0 auto; padding: 0 20px; text-align: var(--bfq-align, left); }
  .bfq__eyebrow { display: block; margin: 0 0 10px; font-family: var(--bfq-body-font); font-size: var(--bfq-eyebrow-size, 16px); font-weight: 500; line-height: 1.3; color: var(--bfq-eyebrow, #2fbd44); }
  .bfq__title { margin: 0 0 24px; font-family: var(--bfq-heading-font); font-size: var(--bfq-heading-size, 32px); font-weight: 700; line-height: 1.15; letter-spacing: -.01em; color: var(--bfq-heading, #1d4d36); overflow-wrap: anywhere; }
  .bfq__list { text-align: left; }
  .bfq__list .bac:last-child { margin-bottom: 0; }
  .bfq__ph { margin: 0; padding: 8px 12px; border: 1.5px dashed #c7a35a; border-radius: 6px; background: rgba(240,165,31,.08); color: #8a5a10; font: 500 14px/1.4 system-ui, sans-serif; }
  #shopify-section-{{ sid }} .bfq { --bfq-bg: {{ s.bg_color }}; --bfq-eyebrow: {{ s.eyebrow_color }}; --bfq-heading: {{ s.heading_color }}; --bfq-heading-font: {{ heading_font }}; --bfq-body-font: {{ body_font }}; --bfq-heading-size: {{ s.heading_size }}px; --bfq-eyebrow-size: {{ s.eyebrow_size }}px; --bfq-max: {{ s.max_width }}px; --bfq-align: {{ s.align }}; --bfq-pad-top: {{ s.padding_top }}px; --bfq-pad-bottom: {{ s.padding_bottom }}px; }
{%- endstyle -%}
<div class="bfq">
  <div class="bfq__wrap">
    {%- if s.eyebrow != blank -%}<span class="bfq__eyebrow">{{ s.eyebrow | escape }}</span>{%- endif -%}
    {%- if s.heading != blank -%}<h2 class="bfq__title">{{ s.heading | escape }}</h2>{%- endif -%}
    {%- if filled > 0 -%}
      <div class="bfq__list">
        {%- for block in qas -%}
          {%- if block.settings.question != blank and block.settings.answer != blank -%}
            {%- assign row_id = 'bfq-' | append: block.id -%}
            {%- render 'boarage-accordion-item', title: block.settings.question, content: block.settings.answer, open: block.settings.open, id: row_id, indicator: s.indicator, icon_color: s.icon_color, box_color: s.box_color, border_color: s.border_color, border_width: s.border_width, radius: s.radius, padding: s.padding, title_color: s.title_color, title_weight: s.title_weight, title_size: s.title_size, title_font: body_font, text_color: s.text_color, text_weight: 400, text_size: s.text_size, text_font: body_font, line_height: line_height, bullet_color: s.bullet_color, gap: s.gap, attrs: block.shopify_attributes -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- elsif request.design_mode -%}
      <p class="bfq__ph">FAQ: add “Question” blocks and fill in a question and an answer.</p>
    {%- endif -%}
  </div>
</div>
{%- if filled > 0 -%}
  {%- capture faq_json -%}
    {%- for block in qas -%}
      {%- if block.settings.question != blank and block.settings.answer != blank -%}
        {%- unless forloop.first -%},{%- endunless -%}
        {"@type":"Question","name":{{ block.settings.question | json }},"acceptedAnswer":{"@type":"Answer","text":{{ block.settings.answer | strip_html | strip | json }}}}
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
  <script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{{ faq_json | strip }}]}</script>
{%- endif -%}

{% schema %}
{
  "name": "Boarage · FAQ",
  "tag": "section",
  "class": "boarage-faq",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Frequently Asked Questions" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Common questions we hear from customers" },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "bg_color", "label": "Section background", "default": "#ffffff" },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow", "default": "#2fbd44" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#1d4d36" },
    { "type": "color", "id": "box_color", "label": "Row background", "default": "#ffffff" },
    { "type": "color", "id": "border_color", "label": "Row border", "default": "#dfe6e2" },
    { "type": "color", "id": "title_color", "label": "Question", "default": "#1d4d36" },
    { "type": "color", "id": "text_color", "label": "Answer", "default": "#1d4d36" },
    { "type": "color", "id": "icon_color", "label": "Plus / minus", "default": "#1d4d36" },
    { "type": "color", "id": "bullet_color", "label": "Bullet check (lists in answers)", "default": "#2fbd44" },
    { "type": "header", "content": "Fonts and sizes" },
    {
      "type": "select",
      "id": "heading_font_source",
      "label": "Heading font",
      "options": [
        { "value": "heading", "label": "Theme heading font" },
        { "value": "body", "label": "Theme body font" },
        { "value": "custom", "label": "Custom (picker below)" }
      ],
      "default": "heading"
    },
    { "type": "font_picker", "id": "heading_font", "label": "Custom heading font", "default": "outfit_n7" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 20, "max": 56, "step": 1, "unit": "px", "default": 32 },
    { "type": "range", "id": "eyebrow_size", "label": "Eyebrow size", "min": 12, "max": 22, "step": 1, "unit": "px", "default": 16 },
    {
      "type": "select",
      "id": "body_font_source",
      "label": "Questions and answers font",
      "options": [
        { "value": "body", "label": "Theme body font" },
        { "value": "heading", "label": "Theme heading font" },
        { "value": "custom", "label": "Custom (picker below)" }
      ],
      "default": "body"
    },
    { "type": "font_picker", "id": "body_font", "label": "Custom font", "default": "work_sans_n4" },
    { "type": "range", "id": "title_size", "label": "Question size", "min": 14, "max": 30, "step": 1, "unit": "px", "default": 19 },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Question weight",
      "options": [
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "600"
    },
    { "type": "range", "id": "text_size", "label": "Answer size", "min": 12, "max": 26, "step": 1, "unit": "px", "default": 17 },
    { "type": "range", "id": "line_height", "label": "Answer line height", "min": 120, "max": 190, "step": 5, "unit": "%", "default": 150 },
    { "type": "header", "content": "Rows" },
    {
      "type": "select",
      "id": "indicator",
      "label": "Open / close indicator",
      "options": [
        { "value": "plus", "label": "Plus / minus" },
        { "value": "chevron", "label": "Chevron" }
      ],
      "default": "plus"
    },
    { "type": "range", "id": "border_width", "label": "Row border width", "info": "0 = no border.", "min": 0, "max": 4, "step": 1, "unit": "px", "default": 1 },
    { "type": "range", "id": "radius", "label": "Row corner radius", "min": 0, "max": 32, "step": 1, "unit": "px", "default": 8 },
    { "type": "range", "id": "padding", "label": "Row inner padding", "min": 8, "max": 40, "step": 2, "unit": "px", "default": 22 },
    { "type": "range", "id": "gap", "label": "Space between rows", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 12 },
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "align",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    { "type": "range", "id": "max_width", "label": "Maximum width", "min": 500, "max": 1200, "step": 20, "unit": "px", "default": 760 },
    { "type": "range", "id": "padding_top", "label": "Space above", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Space below", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Question",
      "limit": 20,
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How do I take it?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "info": "Bold from the toolbar. A bullet list renders as green check-square bullets.", "default": "<p>Write the answer here.</p>" },
        { "type": "checkbox", "id": "open", "label": "Open on page load", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Boarage · FAQ",
      "blocks": [
        { "type": "qa", "settings": { "question": "How do I take it?" } },
        { "type": "qa", "settings": { "question": "When will I see results?" } },
        { "type": "qa", "settings": { "question": "What if it doesn't work for me?" } },
        { "type": "qa", "settings": { "question": "Is this a natural formula?" } },
        { "type": "qa", "settings": { "question": "How is this different from other supplements?" } },
        { "type": "qa", "settings": { "question": "How fast is shipping?" } }
      ]
    }
  ]
}
{% endschema %}
