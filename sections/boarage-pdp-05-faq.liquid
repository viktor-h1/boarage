{%- comment -%} Boarage PDP 05 · FAQ: question/answer accordions with FAQPage JSON-LD for filled entries only. {%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign filled = 0
  for block in section.blocks
    if block.settings.question != blank and block.settings.answer != blank
      assign filled = filled | plus: 1
    endif
  endfor
-%}
{%- if filled > 0 or request.design_mode -%}
  {%- render 'boarage-tokens' -%}
  <div class="bpdp bpdp-s05">
    <div class="bpdp-wrap bpdp-faq">
      {%- if filled == 0 -%}{% render 'boarage-placeholder', label: '05 · FAQ: each entry needs a question and an answer', kind: 'block' %}{%- endif -%}
      {% render 'boarage-section-head', heading: s.heading, heading_label: 'FAQ headline' %}
      <div class="bpdp-accs">
        {%- for block in section.blocks -%}
          {%- assign acc_id = 'bpdp-faq-' | append: block.id -%}
          {% render 'boarage-accordion', title: block.settings.question, content: block.settings.answer, open: false, id: acc_id, attrs: block.shopify_attributes, title_label: 'Question', content_label: 'Answer' %}
        {%- endfor -%}
      </div>
    </div>
  </div>
  {%- if filled > 0 -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {%- assign faq_first = true -%}
          {%- for block in section.blocks -%}
            {%- if block.settings.question != blank and block.settings.answer != blank -%}
              {%- unless faq_first -%},{%- endunless -%}
              {%- assign faq_first = false -%}
              { "@type": "Question", "name": {{ block.settings.question | strip_html | strip | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | strip | json }} } }
            {%- endif -%}
          {%- endfor -%}
        ]
      }
    </script>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "t:boarage.s05.name",
  "tag": "section",
  "class": "bpdp-section",
  "max_blocks": 12,
  "enabled_on": { "templates": ["*"] },
  "settings": [
    { "type": "paragraph", "content": "t:boarage.s05.settings.paragraph" },
    { "type": "text", "id": "heading", "label": "t:boarage.common.heading.label", "info": "t:boarage.common.heading.info" }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "t:boarage.s05.blocks.qa.name",
      "settings": [
        { "type": "text", "id": "question", "label": "t:boarage.s05.blocks.qa.settings.question.label" },
        { "type": "richtext", "id": "answer", "label": "t:boarage.s05.blocks.qa.settings.answer.label" }
      ]
    }
  ],
  "presets": [
    { "name": "t:boarage.s05.name", "blocks": [ { "type": "qa" }, { "type": "qa" }, { "type": "qa" }, { "type": "qa" }, { "type": "qa" }, { "type": "qa" } ] }
  ]
}
{% endschema %}
