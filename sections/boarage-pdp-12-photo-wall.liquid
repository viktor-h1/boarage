{%- comment -%} Boarage PDP 12 · Photo wall / UGC: image blocks with alt text and optional caption. Renders nothing when empty. {%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign photos = 0
  for block in section.blocks
    if block.settings.image != blank
      assign photos = photos | plus: 1
    endif
  endfor
-%}
{%- if photos > 0 or request.design_mode -%}
  {%- render 'boarage-tokens' -%}
  <div class="bpdp bpdp-s12">
    <div class="bpdp-wrap">
      {%- if photos == 0 -%}{% render 'boarage-placeholder', label: '12 · Photo wall: add photo blocks with an image and alt text', kind: 'block' %}{%- endif -%}
      {% render 'boarage-section-head', heading: s.heading, heading_label: 'Photo wall headline (optional)' %}
      <ul class="bpdp-wall" style="--bpdp-wall-cols: {{ s.columns | default: 3 }};">
        {%- for block in section.blocks -%}
          {%- if block.settings.image != blank -%}
            <li class="bpdp-wall__item" {{ block.shopify_attributes }}>
              <figure class="bpdp-figure">
                {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 750px) 33vw, 50vw', class: 'bpdp-wall__img', alt: block.settings.alt }}
                {%- if block.settings.caption != blank -%}
                  <figcaption class="bpdp-wall__caption">{{ block.settings.caption | escape }}</figcaption>
                {%- endif -%}
              </figure>
            </li>
          {%- elsif request.design_mode -%}
            <li class="bpdp-wall__item" {{ block.shopify_attributes }}>{% render 'boarage-placeholder', label: 'Photo + alt text', kind: 'block' %}</li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:boarage.s12.name",
  "tag": "section",
  "class": "bpdp-section",
  "max_blocks": 12,
  "enabled_on": { "templates": ["*"] },
  "settings": [
    { "type": "paragraph", "content": "t:boarage.common.empty_info" },
    { "type": "text", "id": "heading", "label": "t:boarage.common.heading.label", "info": "t:boarage.common.heading.info" },
    { "type": "range", "id": "columns", "label": "t:boarage.s12.settings.columns.label", "min": 2, "max": 4, "step": 1, "default": 3 }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "t:boarage.s12.blocks.photo.name",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "t:boarage.common.image.label" },
        { "type": "text", "id": "alt", "label": "t:boarage.common.image_alt.label", "info": "t:boarage.common.image_alt.info" },
        { "type": "text", "id": "caption", "label": "t:boarage.s12.blocks.photo.settings.caption.label" }
      ]
    }
  ],
  "presets": [
    { "name": "t:boarage.s12.name", "blocks": [ { "type": "photo" }, { "type": "photo" }, { "type": "photo" }, { "type": "photo" }, { "type": "photo" }, { "type": "photo" } ] }
  ]
}
{% endschema %}
