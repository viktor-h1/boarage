{%- comment -%} Boarage PDP 04 · Reviews: app block slot (@app) plus manual review blocks as fallback. {%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign filled = 0
  assign apps = 0
  for block in section.blocks
    if block.type == '@app'
      assign apps = apps | plus: 1
    elsif block.settings.text != blank
      assign filled = filled | plus: 1
    endif
  endfor
  assign has_content = false
  if filled > 0 or apps > 0
    assign has_content = true
  endif
-%}
{%- if has_content or request.design_mode -%}
  {%- render 'boarage-tokens' -%}
  <div class="bpdp bpdp-s04 bpdp-band">
    <div class="bpdp-wrap">
      {%- if has_content == false -%}{% render 'boarage-placeholder', label: '04 · Reviews: add your reviews app block or fill the manual review blocks', kind: 'block' %}{%- endif -%}
      {% render 'boarage-section-head', heading: s.heading, heading_label: 'Reviews headline' %}
      {%- if filled > 0 or request.design_mode -%}
        <ul class="bpdp-reviews">
          {%- for block in section.blocks -%}
            {%- if block.type == 'review' -%}
              {% render 'boarage-review-card', name: block.settings.name, location: block.settings.location, text: block.settings.text, image: block.settings.image, image_alt: block.settings.image_alt, attrs: block.shopify_attributes %}
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if apps > 0 -%}
        <div class="bpdp-reviews__apps">
          {%- for block in section.blocks -%}
            {%- if block.type == '@app' -%}{% render block %}{%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:boarage.s04.name",
  "tag": "section",
  "class": "bpdp-section",
  "enabled_on": { "templates": ["*"] },
  "settings": [
    { "type": "paragraph", "content": "t:boarage.s04.settings.paragraph" },
    { "type": "text", "id": "heading", "label": "t:boarage.common.heading.label", "info": "t:boarage.common.heading.info" }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "review",
      "name": "t:boarage.s04.blocks.review.name",
      "settings": [
        { "type": "textarea", "id": "text", "label": "t:boarage.s04.blocks.review.settings.text.label", "info": "t:boarage.s04.blocks.review.settings.text.info" },
        { "type": "text", "id": "name", "label": "t:boarage.s04.blocks.review.settings.name.label" },
        { "type": "text", "id": "location", "label": "t:boarage.s04.blocks.review.settings.location.label" },
        { "type": "image_picker", "id": "image", "label": "t:boarage.s04.blocks.review.settings.image.label" },
        { "type": "text", "id": "image_alt", "label": "t:boarage.common.image_alt.label", "info": "t:boarage.common.image_alt.info" }
      ]
    }
  ],
  "presets": [
    { "name": "t:boarage.s04.name", "blocks": [ { "type": "review" }, { "type": "review" }, { "type": "review" } ] }
  ]
}
{% endschema %}
