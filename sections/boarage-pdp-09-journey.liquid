{%- comment -%} Boarage PDP 09 · Journey timeline: up to 5 milestones on a gradient rail, optional printed-card visual beside it. {%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign milestones = 0
  for block in section.blocks
    if block.settings.title != blank or block.settings.text != blank or block.settings.when != blank
      assign milestones = milestones | plus: 1
    endif
  endfor
  assign card_filled = false
  if s.card_title != blank or s.card_hint != blank or s.scale_1_label != blank or s.scale_2_label != blank or s.line_1 != blank or s.line_2 != blank
    assign card_filled = true
  endif
  assign show_card = false
  if s.card_enabled
    if card_filled or request.design_mode
      assign show_card = true
    endif
  endif
  assign has_content = false
  if s.heading != blank or s.intro != blank or milestones > 0
    assign has_content = true
  elsif s.card_enabled and card_filled
    assign has_content = true
  endif
-%}
{%- if has_content or request.design_mode -%}
  {%- render 'boarage-tokens' -%}
  <div class="bpdp bpdp-s09">
    <div class="bpdp-wrap">
      {%- if has_content == false -%}{% render 'boarage-placeholder', label: '09 · Journey: headline, intro, milestones and the optional card', kind: 'block' %}{%- endif -%}
      <div class="bpdp-prose">
        {% render 'boarage-section-head', heading: s.heading, intro: s.intro, heading_label: 'Journey headline', intro_label: 'Intro text (rich text)' %}
      </div>
      <div class="bpdp-journey">
        {%- if milestones > 0 or request.design_mode -%}
          <ol class="bpdp-steps" data-bpdp-reveal data-bpdp-stagger="50">
            {%- for block in section.blocks -%}
              {%- if block.settings.title != blank or block.settings.text != blank or block.settings.when != blank or request.design_mode -%}
                <li class="bpdp-step" data-bpdp-reveal-item {{ block.shopify_attributes }}>
                  {%- if block.settings.when != blank -%}
                    <span class="bpdp-step__when">{{ block.settings.when | escape }}</span>
                  {%- elsif request.design_mode -%}
                    <span class="bpdp-step__when">{% render 'boarage-placeholder', label: 'When (milestone label)' %}</span>
                  {%- endif -%}
                  {%- if block.settings.title != blank -%}
                    <h3>{{ block.settings.title | escape }}</h3>
                  {%- elsif request.design_mode -%}
                    <p>{% render 'boarage-placeholder', label: 'Milestone title' %}</p>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <p>{{ block.settings.text | escape | newline_to_br }}</p>
                  {%- elsif request.design_mode -%}
                    {% render 'boarage-placeholder', label: 'Milestone text', kind: 'block' %}
                  {%- endif -%}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ol>
        {%- endif -%}
        {%- if show_card -%}
          <aside class="bpdp-card"{% if s.card_title != blank %} aria-label="{{ s.card_title | escape }}"{% endif %}>
            {%- if s.card_title != blank -%}
              <h3 class="bpdp-card__title">{{ s.card_title | escape }}</h3>
            {%- elsif request.design_mode -%}
              <p class="bpdp-card__title">{% render 'boarage-placeholder', label: 'Card title' %}</p>
            {%- endif -%}
            {%- if s.card_hint != blank -%}
              <p class="bpdp-card__hint">{{ s.card_hint | escape }}</p>
            {%- elsif request.design_mode -%}
              <p class="bpdp-card__hint">{% render 'boarage-placeholder', label: 'Card hint' %}</p>
            {%- endif -%}
            {%- if s.scale_1_label != blank or request.design_mode -%}
              <p class="bpdp-card__scale-label">{% if s.scale_1_label != blank %}{{ s.scale_1_label | escape }}{% else %}{% render 'boarage-placeholder', label: 'First scale label' %}{% endif %}</p>
              <ol class="bpdp-card__scale" aria-hidden="true">{% for i in (1..10) %}<li>{{ i }}</li>{% endfor %}</ol>
            {%- endif -%}
            {%- if s.scale_2_label != blank or request.design_mode -%}
              <p class="bpdp-card__scale-label">{% if s.scale_2_label != blank %}{{ s.scale_2_label | escape }}{% else %}{% render 'boarage-placeholder', label: 'Second scale label' %}{% endif %}</p>
              <ol class="bpdp-card__scale" aria-hidden="true">{% for i in (1..10) %}<li>{{ i }}</li>{% endfor %}</ol>
            {%- endif -%}
            {%- if s.line_1 != blank or s.line_2 != blank or request.design_mode -%}
              <div class="bpdp-card__lines">
                <div class="bpdp-card__line">{% if s.line_1 != blank %}{{ s.line_1 | escape }}{% elsif request.design_mode %}{% render 'boarage-placeholder', label: 'Free-text line 1' %}{% endif %}</div>
                <div class="bpdp-card__line">{% if s.line_2 != blank %}{{ s.line_2 | escape }}{% elsif request.design_mode %}{% render 'boarage-placeholder', label: 'Free-text line 2' %}{% endif %}</div>
              </div>
            {%- endif -%}
          </aside>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:boarage.s09.name",
  "tag": "section",
  "class": "bpdp-section",
  "max_blocks": 5,
  "enabled_on": { "templates": ["*"] },
  "settings": [
    { "type": "paragraph", "content": "t:boarage.common.empty_info" },
    { "type": "text", "id": "heading", "label": "t:boarage.common.heading.label", "info": "t:boarage.common.heading.info" },
    { "type": "richtext", "id": "intro", "label": "t:boarage.common.intro.label" },
    { "type": "header", "content": "t:boarage.s09.settings.card_header" },
    { "type": "paragraph", "content": "t:boarage.s09.settings.card_paragraph" },
    { "type": "checkbox", "id": "card_enabled", "label": "t:boarage.s09.settings.card_enabled.label", "default": true },
    { "type": "text", "id": "card_title", "label": "t:boarage.s09.settings.card_title.label" },
    { "type": "text", "id": "card_hint", "label": "t:boarage.s09.settings.card_hint.label" },
    { "type": "text", "id": "scale_1_label", "label": "t:boarage.s09.settings.scale_1_label.label" },
    { "type": "text", "id": "scale_2_label", "label": "t:boarage.s09.settings.scale_2_label.label" },
    { "type": "text", "id": "line_1", "label": "t:boarage.s09.settings.line_1.label" },
    { "type": "text", "id": "line_2", "label": "t:boarage.s09.settings.line_2.label" }
  ],
  "blocks": [
    {
      "type": "milestone",
      "name": "t:boarage.s09.blocks.milestone.name",
      "settings": [
        { "type": "text", "id": "when", "label": "t:boarage.s09.blocks.milestone.settings.when.label", "info": "t:boarage.s09.blocks.milestone.settings.when.info" },
        { "type": "text", "id": "title", "label": "t:boarage.s09.blocks.milestone.settings.title.label" },
        { "type": "textarea", "id": "text", "label": "t:boarage.s09.blocks.milestone.settings.text.label" }
      ]
    }
  ],
  "presets": [
    { "name": "t:boarage.s09.name", "blocks": [ { "type": "milestone" }, { "type": "milestone" }, { "type": "milestone" }, { "type": "milestone" } ] }
  ]
}
{% endschema %}
