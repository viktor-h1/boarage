{%- comment -%} Boarage PDP 13 · Closing reviews + final CTA: review component again, a guarantee line and a button to the buy box. {%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign filled = 0
  assign apps = 0
  for block in section.blocks
    if block.type == '@app'
      assign apps = apps | plus: 1
    elsif block.settings.text != blank
      assign filled = filled | plus: 1
    endif
  endfor
  assign has_content = false
  if s.heading != blank or filled > 0 or apps > 0 or s.guarantee_line != blank or s.cta_label != blank
    assign has_content = true
  endif
  assign cta_href = s.cta_link | default: '#boarage-buy-box'
-%}
{%- if has_content or request.design_mode -%}
  {%- render 'boarage-tokens' -%}
  <div class="bpdp bpdp-s13 bpdp-band">
    <div class="bpdp-wrap">
      {%- if has_content == false -%}{% render 'boarage-placeholder', label: '13 · Closing: headline, reviews, guarantee line and final button', kind: 'block' %}{%- endif -%}
      {% render 'boarage-section-head', heading: s.heading, heading_label: 'Closing headline', align: 'center' %}
      {%- if filled > 0 or request.design_mode -%}
        <ul class="bpdp-reviews">
          {%- for block in section.blocks -%}
            {%- if block.type == 'review' -%}
              {% render 'boarage-review-card', name: block.settings.name, location: block.settings.location, text: block.settings.text, image: block.settings.image, image_alt: block.settings.image_alt, attrs: block.shopify_attributes %}
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if apps > 0 -%}
        <div class="bpdp-reviews__apps">
          {%- for block in section.blocks -%}
            {%- if block.type == '@app' -%}{% render block %}{%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
      {%- if s.guarantee_line != blank or s.cta_label != blank or request.design_mode -%}
        <div class="bpdp-closing__cta">
          {%- if s.guarantee_line != blank -%}
            <p class="bpdp-closing__line">{% render 'boarage-icon', name: 'shield', size: 22 %}<span>{{ s.guarantee_line | escape }}</span></p>
          {%- elsif request.design_mode -%}
            <p class="bpdp-closing__line">{% render 'boarage-placeholder', label: 'Guarantee line' %}</p>
          {%- endif -%}
          {%- if s.cta_label != blank -%}
            <a class="bpdp-btn bpdp-btn--fit" href="{{ cta_href }}">{{ s.cta_label | escape }}</a>
          {%- elsif request.design_mode -%}
            <p>{% render 'boarage-placeholder', label: 'Button text' %}</p>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:boarage.s13.name",
  "tag": "section",
  "class": "bpdp-section",
  "enabled_on": { "templates": ["*"] },
  "settings": [
    { "type": "paragraph", "content": "t:boarage.s04.settings.paragraph" },
    { "type": "text", "id": "heading", "label": "t:boarage.common.heading.label", "info": "t:boarage.common.heading.info" },
    { "type": "text", "id": "guarantee_line", "label": "t:boarage.s13.settings.guarantee_line.label" },
    { "type": "text", "id": "cta_label", "label": "t:boarage.common.cta_label.label" },
    { "type": "url", "id": "cta_link", "label": "t:boarage.common.cta_link.label", "info": "t:boarage.common.cta_link.info" }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "review",
      "name": "t:boarage.s04.blocks.review.name",
      "settings": [
        { "type": "textarea", "id": "text", "label": "t:boarage.s04.blocks.review.settings.text.label", "info": "t:boarage.s04.blocks.review.settings.text.info" },
        { "type": "text", "id": "name", "label": "t:boarage.s04.blocks.review.settings.name.label" },
        { "type": "text", "id": "location", "label": "t:boarage.s04.blocks.review.settings.location.label" },
        { "type": "image_picker", "id": "image", "label": "t:boarage.s04.blocks.review.settings.image.label" },
        { "type": "text", "id": "image_alt", "label": "t:boarage.common.image_alt.label", "info": "t:boarage.common.image_alt.info" }
      ]
    }
  ],
  "presets": [
    { "name": "t:boarage.s13.name", "blocks": [ { "type": "review" }, { "type": "review" } ] }
  ]
}
{% endschema %}
