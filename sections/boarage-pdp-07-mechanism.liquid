{%- comment -%} Boarage PDP 07 · Mechanism: rich text column + sensation panel, then an ingredient list. {%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign ingredients = 0
  for block in section.blocks
    if block.settings.name != blank or block.settings.role != blank
      assign ingredients = ingredients | plus: 1
    endif
  endfor
  assign panel_filled = false
  if s.left_title != blank or s.left_text != blank or s.right_title != blank or s.right_text != blank or s.axis_start != blank or s.axis_end != blank
    assign panel_filled = true
  endif
  assign has_content = false
  if s.heading != blank or s.text != blank or ingredients > 0 or panel_filled
    assign has_content = true
  endif
-%}
{%- if has_content or request.design_mode -%}
  {%- render 'boarage-tokens' -%}
  <div class="bpdp bpdp-s07 bpdp-band">
    <div class="bpdp-wrap">
      {%- if has_content == false -%}{% render 'boarage-placeholder', label: '07 · Mechanism: headline, text, sensation panel and ingredients', kind: 'block' %}{%- endif -%}
      <div class="bpdp-mech">
        {%- if s.heading != blank or s.text != blank or ingredients > 0 or request.design_mode -%}
          <div>
            {%- if s.heading != blank -%}
              <h2>{{ s.heading | escape }}</h2>
            {%- elsif request.design_mode -%}
              <p>{% render 'boarage-placeholder', label: 'Mechanism headline' %}</p>
            {%- endif -%}
            {%- if s.text != blank -%}
              <div class="bpdp-rte">{{ s.text }}</div>
            {%- elsif request.design_mode -%}
              {% render 'boarage-placeholder', label: 'Mechanism text (rich text)', kind: 'block' %}
            {%- endif -%}
            {%- if ingredients > 0 or request.design_mode -%}
              <ul class="bpdp-ingr">
                {%- for block in section.blocks -%}
                  {%- if block.settings.name != blank or block.settings.role != blank or request.design_mode -%}
                    <li class="bpdp-ingr__item" {{ block.shopify_attributes }}>
                      <span class="bpdp-ingr__name">{% if block.settings.name != blank %}{{ block.settings.name | escape }}{% else %}{% render 'boarage-placeholder', label: 'Ingredient name' %}{% endif %}</span>
                      <span>{% if block.settings.role != blank %}{{ block.settings.role | escape }}{% else %}{% render 'boarage-placeholder', label: 'What it does' %}{% endif %}</span>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        {%- endif -%}
        {% render 'boarage-sensation-panel', left_title: s.left_title, left_text: s.left_text, right_title: s.right_title, right_text: s.right_text, axis_start: s.axis_start, axis_end: s.axis_end %}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:boarage.s07.name",
  "tag": "section",
  "class": "bpdp-section",
  "max_blocks": 8,
  "enabled_on": { "templates": ["*"] },
  "settings": [
    { "type": "paragraph", "content": "t:boarage.common.empty_info" },
    { "type": "text", "id": "heading", "label": "t:boarage.common.heading.label", "info": "t:boarage.common.heading.info" },
    { "type": "richtext", "id": "text", "label": "t:boarage.common.text.label" },
    { "type": "header", "content": "t:boarage.panel.header" },
    { "type": "paragraph", "content": "t:boarage.panel.paragraph" },
    { "type": "text", "id": "left_title", "label": "t:boarage.panel.left_title" },
    { "type": "textarea", "id": "left_text", "label": "t:boarage.panel.left_text" },
    { "type": "text", "id": "right_title", "label": "t:boarage.panel.right_title" },
    { "type": "textarea", "id": "right_text", "label": "t:boarage.panel.right_text" },
    { "type": "text", "id": "axis_start", "label": "t:boarage.panel.axis_start" },
    { "type": "text", "id": "axis_end", "label": "t:boarage.panel.axis_end" }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "t:boarage.s07.blocks.ingredient.name",
      "settings": [
        { "type": "text", "id": "name", "label": "t:boarage.s07.blocks.ingredient.settings.name.label" },
        { "type": "text", "id": "role", "label": "t:boarage.s07.blocks.ingredient.settings.role.label" }
      ]
    }
  ],
  "presets": [
    { "name": "t:boarage.s07.name", "blocks": [ { "type": "ingredient" }, { "type": "ingredient" }, { "type": "ingredient" }, { "type": "ingredient" }, { "type": "ingredient" } ] }
  ]
}
{% endschema %}
