{%- comment -%} Boarage PDP 11 · Guarantee: full-width panel with badge (number + word), headline, text, CTA to the buy box. {%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign has_badge = false
  if s.badge_number != blank or s.badge_word != blank
    assign has_badge = true
  endif
  assign has_content = false
  if has_badge or s.heading != blank or s.text != blank or s.cta_label != blank
    assign has_content = true
  endif
  assign cta_href = s.cta_link | default: '#boarage-buy-box'
-%}
{%- if has_content or request.design_mode -%}
  {%- render 'boarage-tokens' -%}
  <div class="bpdp bpdp-s11">
    <div class="bpdp-wrap">
      {%- if has_content == false -%}{% render 'boarage-placeholder', label: '11 · Guarantee: badge, headline, text and button', kind: 'block' %}{%- endif -%}
      <div class="bpdp-promise">
        {%- if has_badge -%}
          {% render 'boarage-guarantee-badge', number: s.badge_number, word: s.badge_word %}
        {%- elsif request.design_mode -%}
          <div>{% render 'boarage-placeholder', label: 'Badge: number + word', kind: 'block' %}</div>
        {%- endif -%}
        <div class="bpdp-promise__body">
          {%- if s.heading != blank -%}
            <h2>{{ s.heading | escape }}</h2>
          {%- elsif request.design_mode -%}
            <p>{% render 'boarage-placeholder', label: 'Guarantee headline' %}</p>
          {%- endif -%}
          {%- if s.text != blank -%}
            <div class="bpdp-rte">{{ s.text }}</div>
          {%- elsif request.design_mode -%}
            {% render 'boarage-placeholder', label: 'Guarantee text (rich text)', kind: 'block' %}
          {%- endif -%}
          {%- if s.cta_label != blank -%}
            <a class="bpdp-btn bpdp-btn--inverse" href="{{ cta_href }}">{{ s.cta_label | escape }}</a>
          {%- elsif request.design_mode -%}
            <p>{% render 'boarage-placeholder', label: 'Button text' %}</p>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:boarage.s11.name",
  "tag": "section",
  "class": "bpdp-section",
  "enabled_on": { "templates": ["*"] },
  "settings": [
    { "type": "paragraph", "content": "t:boarage.common.empty_info" },
    { "type": "text", "id": "badge_number", "label": "t:boarage.s11.settings.badge_number.label", "info": "t:boarage.s11.settings.badge_number.info" },
    { "type": "text", "id": "badge_word", "label": "t:boarage.s11.settings.badge_word.label" },
    { "type": "text", "id": "heading", "label": "t:boarage.common.heading.label", "info": "t:boarage.common.heading.info" },
    { "type": "richtext", "id": "text", "label": "t:boarage.common.text.label" },
    { "type": "text", "id": "cta_label", "label": "t:boarage.common.cta_label.label" },
    { "type": "url", "id": "cta_link", "label": "t:boarage.common.cta_link.label", "info": "t:boarage.common.cta_link.info" }
  ],
  "presets": [ { "name": "t:boarage.s11.name" } ]
}
{% endschema %}
