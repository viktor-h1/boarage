{%- comment -%} Boarage PDP 01 · Announcement strip: up to 4 short items, optional link each. {%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign filled = 0
  for block in section.blocks
    if block.settings.text != blank
      assign filled = filled | plus: 1
    endif
  endfor
-%}
{%- if filled > 0 or request.design_mode -%}
  {%- render 'boarage-tokens' -%}
  <div class="bpdp">
    {%- if filled == 0 -%}{% render 'boarage-placeholder', label: '01 · Announcement strip: fill the item texts below', kind: 'block' %}{%- endif -%}
    <div class="bpdp-strip bpdp-strip--{{ s.style | default: 'accent' }}">
      <ul class="bpdp-strip__list">
        {%- for block in section.blocks -%}
          {%- if block.settings.text != blank or request.design_mode -%}
            <li class="bpdp-strip__item" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != blank and block.settings.icon != 'none' -%}{% render 'boarage-icon', name: block.settings.icon, size: 20 %}{%- endif -%}
              {%- if block.settings.text != blank -%}
                {%- if block.settings.link != blank -%}
                  <a class="bpdp-strip__link" href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
                {%- else -%}
                  <span>{{ block.settings.text | escape }}</span>
                {%- endif -%}
              {%- else -%}
                {% render 'boarage-placeholder', label: 'Strip item text' %}
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:boarage.s01.name",
  "tag": "section",
  "class": "bpdp-section",
  "max_blocks": 4,
  "enabled_on": { "templates": ["*"] },
  "settings": [
    { "type": "paragraph", "content": "t:boarage.common.empty_info" },
    {
      "type": "select",
      "id": "style",
      "label": "t:boarage.s01.settings.style.label",
      "options": [
        { "value": "accent", "label": "t:boarage.s01.settings.style.options.accent" },
        { "value": "surface", "label": "t:boarage.s01.settings.style.options.surface" }
      ],
      "default": "accent"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "t:boarage.s01.blocks.item.name",
      "settings": [
        { "type": "text", "id": "text", "label": "t:boarage.s01.blocks.item.settings.text.label", "info": "t:boarage.s01.blocks.item.settings.text.info" },
        { "type": "url", "id": "link", "label": "t:boarage.common.link.label", "info": "t:boarage.common.link.info" },
        {
          "type": "select",
          "id": "icon",
          "label": "t:boarage.common.icon.label",
          "options": [
            { "value": "none", "label": "t:boarage.icons.none" },
            { "value": "shield", "label": "t:boarage.icons.shield" },
            { "value": "box", "label": "t:boarage.icons.box" },
            { "value": "truck", "label": "t:boarage.icons.truck" },
            { "value": "chat", "label": "t:boarage.icons.chat" },
            { "value": "invoice", "label": "t:boarage.icons.invoice" },
            { "value": "lock", "label": "t:boarage.icons.lock" },
            { "value": "leaf", "label": "t:boarage.icons.leaf" },
            { "value": "drop", "label": "t:boarage.icons.drop" },
            { "value": "snowflake", "label": "t:boarage.icons.snowflake" },
            { "value": "flame", "label": "t:boarage.icons.flame" },
            { "value": "wave", "label": "t:boarage.icons.wave" },
            { "value": "hand", "label": "t:boarage.icons.hand" },
            { "value": "heart", "label": "t:boarage.icons.heart" },
            { "value": "jar", "label": "t:boarage.icons.jar" },
            { "value": "clock", "label": "t:boarage.icons.clock" },
            { "value": "star", "label": "t:boarage.icons.star" },
            { "value": "check", "label": "t:boarage.icons.check" }
          ],
          "default": "none"
        }
      ]
    }
  ],
  "presets": [
    { "name": "t:boarage.s01.name", "blocks": [ { "type": "item" }, { "type": "item" }, { "type": "item" } ] }
  ]
}
{% endschema %}
