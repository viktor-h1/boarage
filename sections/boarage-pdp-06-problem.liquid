{%- comment -%} Boarage PDP 06 · Problem reframe: headline, intro, three stages (3-up on desktop, stacked on mobile). {%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign filled = 0
  for block in section.blocks
    if block.settings.title != blank or block.settings.text != blank or block.settings.label != blank
      assign filled = filled | plus: 1
    endif
  endfor
  assign has_content = false
  if s.heading != blank or s.intro != blank or filled > 0
    assign has_content = true
  endif
-%}
{%- if has_content or request.design_mode -%}
  {%- render 'boarage-tokens' -%}
  <div class="bpdp bpdp-s06">
    <div class="bpdp-wrap">
      {%- if has_content == false -%}{% render 'boarage-placeholder', label: '06 · Problem reframe: headline, intro and three stages', kind: 'block' %}{%- endif -%}
      <div class="bpdp-prose">
        {% render 'boarage-section-head', heading: s.heading, intro: s.intro, heading_label: 'Problem headline', intro_label: 'Intro text (rich text)' %}
      </div>
      {%- if filled > 0 or request.design_mode -%}
        <ol class="bpdp-stages" data-bpdp-reveal data-bpdp-stagger="50">
          {%- for block in section.blocks -%}
            {%- if block.settings.title != blank or block.settings.text != blank or block.settings.label != blank or request.design_mode -%}
              <li class="bpdp-stage" data-bpdp-reveal-item {{ block.shopify_attributes }}>
                {%- if block.settings.label != blank -%}
                  <span class="bpdp-label bpdp-stage__label">{{ block.settings.label | escape }}</span>
                {%- elsif request.design_mode -%}
                  <span class="bpdp-label bpdp-stage__label">{% render 'boarage-placeholder', label: 'Stage label' %}</span>
                {%- endif -%}
                {%- if block.settings.title != blank -%}
                  <h3>{{ block.settings.title | escape }}</h3>
                {%- elsif request.design_mode -%}
                  <p>{% render 'boarage-placeholder', label: 'Stage title' %}</p>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <p>{{ block.settings.text | escape | newline_to_br }}</p>
                {%- elsif request.design_mode -%}
                  {% render 'boarage-placeholder', label: 'Stage text', kind: 'block' %}
                {%- endif -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ol>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:boarage.s06.name",
  "tag": "section",
  "class": "bpdp-section",
  "max_blocks": 3,
  "enabled_on": { "templates": ["*"] },
  "settings": [
    { "type": "paragraph", "content": "t:boarage.common.empty_info" },
    { "type": "text", "id": "heading", "label": "t:boarage.common.heading.label", "info": "t:boarage.common.heading.info" },
    { "type": "richtext", "id": "intro", "label": "t:boarage.common.intro.label" }
  ],
  "blocks": [
    {
      "type": "stage",
      "name": "t:boarage.s06.blocks.stage.name",
      "settings": [
        { "type": "text", "id": "label", "label": "t:boarage.s06.blocks.stage.settings.label.label", "info": "t:boarage.s06.blocks.stage.settings.label.info" },
        { "type": "text", "id": "title", "label": "t:boarage.s06.blocks.stage.settings.title.label" },
        { "type": "textarea", "id": "text", "label": "t:boarage.s06.blocks.stage.settings.text.label" }
      ]
    }
  ],
  "presets": [
    { "name": "t:boarage.s06.name", "blocks": [ { "type": "stage" }, { "type": "stage" }, { "type": "stage" } ] }
  ]
}
{% endschema %}
