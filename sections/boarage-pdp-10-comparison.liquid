{%- comment -%} Boarage PDP 10 · Comparison table: column blocks (first = us) and row blocks with per-column values; yes/no/varies get styled tokens. {%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign columns = section.blocks | where: 'type', 'column'
  assign rows = section.blocks | where: 'type', 'row'
  assign col_count = 0
  for c in columns
    if c.settings.label != blank
      assign col_count = col_count | plus: 1
    endif
  endfor
  assign row_count = 0
  for r in rows
    if r.settings.label != blank
      assign row_count = row_count | plus: 1
    endif
  endfor
  assign has_content = false
  if s.heading != blank or col_count > 0 or row_count > 0
    assign has_content = true
  endif
-%}
{%- if has_content or request.design_mode -%}
  {%- render 'boarage-tokens' -%}
  <div class="bpdp bpdp-s10 bpdp-band">
    <div class="bpdp-wrap">
      {%- if has_content == false -%}{% render 'boarage-placeholder', label: '10 · Comparison table: headline, column blocks (first one is you) and row blocks', kind: 'block' %}{%- endif -%}
      <div class="bpdp-prose">
        {% render 'boarage-section-head', heading: s.heading, heading_label: 'Comparison headline' %}
      </div>
      {%- if col_count > 0 or row_count > 0 or request.design_mode -%}
        <div class="bpdp-tablewrap" role="region"{% if s.heading != blank %} aria-label="{{ s.heading | escape }}"{% endif %} tabindex="0">
          <table class="bpdp-table">
            <thead>
              <tr>
                <td></td>
                {%- for c in columns limit: 5 -%}
                  {%- if c.settings.label != blank or request.design_mode -%}
                    <th scope="col"{% if forloop.first %} class="bpdp-table__us"{% endif %} {{ c.shopify_attributes }}>{% if c.settings.label != blank %}{{ c.settings.label | escape }}{% else %}{% render 'boarage-placeholder', label: 'Column' %}{% endif %}</th>
                  {%- endif -%}
                {%- endfor -%}
              </tr>
            </thead>
            <tbody>
              {%- for r in rows -%}
                {%- if r.settings.label != blank or request.design_mode -%}
                  <tr {{ r.shopify_attributes }}>
                    <th scope="row">{% if r.settings.label != blank %}{{ r.settings.label | escape }}{% else %}{% render 'boarage-placeholder', label: 'Row label' %}{% endif %}</th>
                    {%- for c in columns limit: 5 -%}
                      {%- if c.settings.label != blank or request.design_mode -%}
                        {%- liquid
                          assign key = 'value_' | append: forloop.index
                          assign val = r.settings[key] | strip
                          assign v = val | downcase
                        -%}
                        <td{% if forloop.first %} class="bpdp-table__us"{% endif %}>
                          {%- case v -%}
                            {%- when 'yes', 'ja' -%}
                              <span class="bpdp-tok bpdp-tok--yes">{% render 'boarage-icon', name: 'check', size: 18 %}{{ val | escape }}</span>
                            {%- when 'no', 'nein' -%}
                              <span class="bpdp-tok bpdp-tok--no">{% render 'boarage-icon', name: 'x', size: 18 %}{{ val | escape }}</span>
                            {%- when 'varies', 'teils', 'unterschiedlich' -%}
                              <span class="bpdp-tok bpdp-tok--varies">{% render 'boarage-icon', name: 'wave', size: 18 %}{{ val | escape }}</span>
                            {%- else -%}
                              {%- if val != blank -%}{{ val | escape }}{%- elsif request.design_mode -%}{% render 'boarage-placeholder', label: 'Value' %}{%- endif -%}
                          {%- endcase -%}
                        </td>
                      {%- endif -%}
                    {%- endfor -%}
                  </tr>
                {%- endif -%}
              {%- endfor -%}
            </tbody>
          </table>
        </div>
      {%- endif -%}
      {%- if s.note != blank -%}
        <p class="bpdp-table__note">{{ s.note | escape | newline_to_br }}</p>
      {%- elsif request.design_mode -%}
        <p class="bpdp-table__note">{% render 'boarage-placeholder', label: 'Footnote under the table (optional)' %}</p>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:boarage.s10.name",
  "tag": "section",
  "class": "bpdp-section",
  "enabled_on": { "templates": ["*"] },
  "settings": [
    { "type": "paragraph", "content": "t:boarage.s10.settings.paragraph" },
    { "type": "text", "id": "heading", "label": "t:boarage.common.heading.label", "info": "t:boarage.common.heading.info" },
    { "type": "textarea", "id": "note", "label": "t:boarage.s10.settings.note.label" }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "t:boarage.s10.blocks.column.name",
      "limit": 5,
      "settings": [
        { "type": "paragraph", "content": "t:boarage.s10.blocks.column.paragraph" },
        { "type": "text", "id": "label", "label": "t:boarage.s10.blocks.column.settings.label.label" }
      ]
    },
    {
      "type": "row",
      "name": "t:boarage.s10.blocks.row.name",
      "settings": [
        { "type": "paragraph", "content": "t:boarage.s10.blocks.row.paragraph" },
        { "type": "text", "id": "label", "label": "t:boarage.s10.blocks.row.settings.label.label" },
        { "type": "text", "id": "value_1", "label": "t:boarage.s10.blocks.row.settings.value_1.label" },
        { "type": "text", "id": "value_2", "label": "t:boarage.s10.blocks.row.settings.value_2.label" },
        { "type": "text", "id": "value_3", "label": "t:boarage.s10.blocks.row.settings.value_3.label" },
        { "type": "text", "id": "value_4", "label": "t:boarage.s10.blocks.row.settings.value_4.label" },
        { "type": "text", "id": "value_5", "label": "t:boarage.s10.blocks.row.settings.value_5.label" }
      ]
    }
  ],
  "presets": [
    { "name": "t:boarage.s10.name", "blocks": [ { "type": "column" }, { "type": "column" }, { "type": "column" }, { "type": "column" }, { "type": "row" }, { "type": "row" }, { "type": "row" }, { "type": "row" }, { "type": "row" }, { "type": "row" } ] }
  ]
}
{% endschema %}
