{%- comment -%}
  Boarage PDP 14 · Legal strip: category line, disclaimer notes, INCI list and the German mandatory
  links (Impressum, Widerruf, Datenschutz) on the dark footer background.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign has_content = false
  if s.category_line != blank or s.note_1 != blank or s.note_2 != blank or s.note_3 != blank or s.inci != blank or s.impressum_label != blank or s.widerruf_label != blank or s.datenschutz_label != blank
    assign has_content = true
  endif
-%}
{%- if has_content or request.design_mode -%}
  {%- render 'boarage-tokens' -%}
  <div class="bpdp bpdp-sec bpdp-sec--dark">
    <div class="bpdp-wrap bpdp-legal">
      <div class="bpdp-legal__cols">
        <div class="bpdp-stack">
          {%- if s.category_line != blank -%}<p><b>{{ s.category_line | escape }}</b></p>{%- elsif request.design_mode -%}<p>{% render 'boarage-placeholder', label: '14 · Product category line' %}</p>{%- endif -%}
          {%- if s.note_1 != blank -%}<div class="bpdp-rte">{{ s.note_1 }}</div>{%- elsif request.design_mode -%}<p>{% render 'boarage-placeholder', label: 'Note 1 (e.g. health claims disclaimer)' %}</p>{%- endif -%}
          {%- if s.note_2 != blank -%}<div class="bpdp-rte">{{ s.note_2 }}</div>{%- elsif request.design_mode -%}<p>{% render 'boarage-placeholder', label: 'Note 2 (e.g. individual results)' %}</p>{%- endif -%}
          {%- if s.note_3 != blank -%}<div class="bpdp-rte">{{ s.note_3 }}</div>{%- elsif request.design_mode -%}<p>{% render 'boarage-placeholder', label: 'Note 3 (e.g. consult a doctor)' %}</p>{%- endif -%}
        </div>
        <div class="bpdp-stack">
          {%- if s.inci_heading != blank -%}<p><b>{{ s.inci_heading | escape }}</b></p>{%- endif -%}
          {%- if s.inci != blank -%}<div class="bpdp-rte">{{ s.inci }}</div>{%- elsif request.design_mode -%}<p>{% render 'boarage-placeholder', label: 'INCI / ingredients list' %}</p>{%- endif -%}
          {%- if s.impressum_label != blank or s.widerruf_label != blank or s.datenschutz_label != blank or request.design_mode -%}
            <p class="bpdp-legal__links">
              {%- if s.impressum_label != blank -%}<a href="{{ s.impressum_link | default: '#' }}">{{ s.impressum_label | escape }}</a>{%- elsif request.design_mode -%}{% render 'boarage-placeholder', label: 'Impressum link' %}{%- endif -%}
              {%- if s.widerruf_label != blank -%}<a href="{{ s.widerruf_link | default: '#' }}">{{ s.widerruf_label | escape }}</a>{%- elsif request.design_mode -%}{% render 'boarage-placeholder', label: 'Widerruf link' %}{%- endif -%}
              {%- if s.datenschutz_label != blank -%}<a href="{{ s.datenschutz_link | default: '#' }}">{{ s.datenschutz_label | escape }}</a>{%- elsif request.design_mode -%}{% render 'boarage-placeholder', label: 'Datenschutz link' %}{%- endif -%}
            </p>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:boarage.s14.name",
  "tag": "section",
  "class": "bpdp-section bpdp-section--dark",
  "enabled_on": { "templates": ["*"] },
  "settings": [
    { "type": "paragraph", "content": "t:boarage.s14.settings.paragraph" },
    { "type": "text", "id": "category_line", "label": "t:boarage.s14.settings.category_line.label", "info": "t:boarage.s14.settings.category_line.info" },
    { "type": "richtext", "id": "note_1", "label": "t:boarage.s14.settings.note_1.label" },
    { "type": "richtext", "id": "note_2", "label": "t:boarage.s14.settings.note_2.label" },
    { "type": "richtext", "id": "note_3", "label": "t:boarage.s14.settings.note_3.label" },
    { "type": "text", "id": "inci_heading", "label": "t:boarage.s14.settings.inci_heading.label" },
    { "type": "richtext", "id": "inci", "label": "t:boarage.s14.settings.inci.label" },
    { "type": "header", "content": "t:boarage.s14.settings.links_header" },
    { "type": "text", "id": "impressum_label", "label": "t:boarage.s14.settings.impressum_label.label" },
    { "type": "url", "id": "impressum_link", "label": "t:boarage.s14.settings.impressum_link.label" },
    { "type": "text", "id": "widerruf_label", "label": "t:boarage.s14.settings.widerruf_label.label" },
    { "type": "url", "id": "widerruf_link", "label": "t:boarage.s14.settings.widerruf_link.label" },
    { "type": "text", "id": "datenschutz_label", "label": "t:boarage.s14.settings.datenschutz_label.label" },
    { "type": "url", "id": "datenschutz_link", "label": "t:boarage.s14.settings.datenschutz_link.label" }
  ],
  "presets": [{ "name": "t:boarage.s14.name" }]
}
{% endschema %}
