{%- comment -%}
  Boarage PDP · Stages ("How nerve breakdown progresses over time"). Centered heading, then one card per
  "Stage" block: image on the left, pale green panel on the right with a small uppercase label, a bold title
  and text. Cards stack on mobile; on desktop they sit in a row (or keep stacking, per setting). Own CSS.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign sid = section.id
  assign stages = section.blocks | where: 'type', 'stage'
  case s.heading_font_source
    when 'body'
      assign heading_font = 'var(--font-body-family, system-ui, sans-serif)'
    when 'custom'
      assign heading_font = s.heading_font.family | append: ', ' | append: s.heading_font.fallback_families
    else
      assign heading_font = 'var(--font-heading-family, system-ui, sans-serif)'
  endcase
  case s.body_font_source
    when 'heading'
      assign body_font = 'var(--font-heading-family, system-ui, sans-serif)'
    when 'custom'
      assign body_font = s.body_font.family | append: ', ' | append: s.body_font.fallback_families
    else
      assign body_font = 'var(--font-body-family, system-ui, sans-serif)'
  endcase
  assign cols = stages.size | at_most: s.columns | at_least: 1
  if s.image_ratio == blank or s.image_ratio == 'fill'
    assign ratio = 'auto'
  else
    assign ratio = s.image_ratio
  endif
-%}
{%- if s.heading_font_source == 'custom' and s.heading_font != blank -%}
  {%- style -%}{{ s.heading_font | font_face: font_display: 'swap' }}{%- endstyle -%}
{%- endif -%}
{%- if s.body_font_source == 'custom' and s.body_font != blank -%}
  {%- style -%}{{ s.body_font | font_face: font_display: 'swap' }}{%- endstyle -%}
{%- endif -%}
{%- style -%}
  .bst { box-sizing: border-box; padding: var(--bst-pad-top, 40px) 0 var(--bst-pad-bottom, 40px); background: var(--bst-bg, #fff); font-family: var(--bst-body-font); font-size: var(--bst-text-size, 17px); line-height: 1.5; color: var(--bst-text, #1d4d36); -webkit-font-smoothing: antialiased; }
  .bst *, .bst *::before, .bst *::after { box-sizing: border-box; }
  .bst__wrap { max-width: var(--bst-max, 1100px); margin: 0 auto; padding: 0 20px; }
  .bst__title { margin: 0 auto 24px; max-width: 720px; font-family: var(--bst-heading-font); font-size: var(--bst-heading-size, 28px); font-weight: 700; line-height: 1.2; letter-spacing: -.01em; text-align: center; color: var(--bst-heading, #1d4d36); overflow-wrap: anywhere; }
  .bst__grid { display: grid; grid-template-columns: 1fr; gap: var(--bst-gap, 16px); margin: 0; padding: 0; list-style: none; }
  .bst__card { display: grid; grid-template-columns: var(--bst-img-w, 40%) 1fr; margin: 0; border-radius: var(--bst-radius, 8px); overflow: hidden; background: var(--bst-card, #eef7f1); }
  .bst__media { position: relative; min-height: 100%; background: #dfe6e2; }
  .bst__media::before { content: ""; display: block; padding-top: var(--bst-min-pad, 0); }
  .bst__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: var(--bst-focus, 50% 50%); display: block; }
  .bst__media--empty { min-height: 220px; }
  .bst--top .bst__card { grid-template-columns: 1fr; grid-template-rows: auto 1fr; }
  .bst--top .bst__media { min-height: 0; aspect-ratio: var(--bst-ratio, 4 / 3); }
  .bst--top .bst__media::before { display: none; }
  .bst__body { padding: 20px 18px 22px; }
  .bst__label { display: block; margin: 0 0 6px; font-size: .8em; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--bst-label, #2fbd44); }
  .bst__card-title { margin: 0 0 10px; font-family: var(--bst-body-font); font-size: var(--bst-card-title-size, 20px); font-weight: 700; line-height: 1.25; color: var(--bst-card-title, #1d4d36); }
  .bst__text { margin: 0; font-size: .95em; }
  .bst__text p { margin: 0 0 .8em; }
  .bst__text p:last-child { margin-bottom: 0; }
  .bst__text strong { font-weight: 700; }
  @media (min-width: 750px) {
    .bst--row .bst__grid { grid-template-columns: repeat(var(--bst-cols, 3), minmax(0, 1fr)); gap: var(--bst-gap, 16px); }
    .bst--row .bst__card { grid-template-columns: 1fr; grid-template-rows: auto 1fr; }
    .bst--row .bst__media { aspect-ratio: var(--bst-ratio, 4 / 3); min-height: 0; }
    .bst--row .bst__media::before { display: none; }
    .bst--row .bst__body { padding: 22px 22px 26px; }
    .bst--stack .bst__wrap { max-width: min(var(--bst-max, 1100px), 760px); }
  }
  .bst__ph { margin: 0; padding: 8px 12px; border: 1.5px dashed #c7a35a; border-radius: 6px; background: rgba(240,165,31,.08); color: #8a5a10; font: 500 14px/1.4 system-ui, sans-serif; text-align: center; }
  #shopify-section-{{ sid }} .bst { --bst-bg: {{ s.bg_color }}; --bst-heading: {{ s.heading_color }}; --bst-card: {{ s.card_color }}; --bst-label: {{ s.label_color }}; --bst-card-title: {{ s.card_title_color }}; --bst-text: {{ s.text_color }}; --bst-heading-font: {{ heading_font }}; --bst-body-font: {{ body_font }}; --bst-heading-size: {{ s.heading_size }}px; --bst-card-title-size: {{ s.card_title_size }}px; --bst-text-size: {{ s.text_size }}px; --bst-img-w: {{ s.image_width }}%; {% if ratio != 'auto' %}--bst-ratio: {{ ratio }}; --bst-min-pad: calc(100% / ({{ ratio }})); {% endif %}--bst-radius: {{ s.radius }}px; --bst-gap: {{ s.gap }}px; --bst-cols: {{ cols }}; --bst-max: {{ s.max_width }}px; --bst-pad-top: {{ s.padding_top }}px; --bst-pad-bottom: {{ s.padding_bottom }}px; }
{%- endstyle -%}
<div class="bst bst--{{ s.desktop_layout | default: 'row' }}{% if s.mobile_layout == 'top' %} bst--top{% endif %}">
  <div class="bst__wrap">
    {%- if s.heading != blank -%}<h2 class="bst__title">{{ s.heading | escape }}</h2>{%- endif -%}
    {%- if stages.size > 0 -%}
      <ul class="bst__grid">
        {%- for block in stages -%}
          {%- assign b = block.settings -%}
          <li class="bst__card" {{ block.shopify_attributes }}>
            <div class="bst__media{% if b.image == blank %} bst__media--empty{% endif %}"{% if b.image_focus != blank and b.image_focus != 'center' %} style="--bst-focus: 50% {% if b.image_focus == 'top' %}0%{% else %}100%{% endif %};"{% endif %}>
              {%- if b.image != blank -%}
                {{ b.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300, 450, 600, 900', sizes: '(min-width: 750px) 400px, 40vw', alt: b.image_alt | default: b.image.alt }}
              {%- endif -%}
            </div>
            <div class="bst__body">
              {%- if b.label != blank -%}<span class="bst__label">{{ b.label | escape }}</span>{%- endif -%}
              {%- if b.title != blank -%}<h3 class="bst__card-title">{{ b.title | escape }}</h3>{%- endif -%}
              {%- if b.text != blank -%}<div class="bst__text">{{ b.text }}</div>{%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- elsif request.design_mode -%}
      <p class="bst__ph">Stages: add “Stage” blocks to this section.</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Boarage · Stages",
  "tag": "section",
  "class": "boarage-stages",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "How Nerve Breakdown Progresses Over Time" },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "bg_color", "label": "Section background", "default": "#ffffff" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#1d4d36" },
    { "type": "color", "id": "card_color", "label": "Card background", "default": "#eef7f1" },
    { "type": "color", "id": "label_color", "label": "Stage label", "default": "#2fbd44" },
    { "type": "color", "id": "card_title_color", "label": "Card title", "default": "#1d4d36" },
    { "type": "color", "id": "text_color", "label": "Card text", "default": "#1d4d36" },
    { "type": "header", "content": "Fonts and sizes" },
    {
      "type": "select",
      "id": "heading_font_source",
      "label": "Heading font",
      "options": [
        { "value": "heading", "label": "Theme heading font" },
        { "value": "body", "label": "Theme body font" },
        { "value": "custom", "label": "Custom (picker below)" }
      ],
      "default": "heading"
    },
    { "type": "font_picker", "id": "heading_font", "label": "Custom heading font", "default": "outfit_n7" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 20, "max": 56, "step": 1, "unit": "px", "default": 28 },
    {
      "type": "select",
      "id": "body_font_source",
      "label": "Card font",
      "options": [
        { "value": "body", "label": "Theme body font" },
        { "value": "heading", "label": "Theme heading font" },
        { "value": "custom", "label": "Custom (picker below)" }
      ],
      "default": "body"
    },
    { "type": "font_picker", "id": "body_font", "label": "Custom card font", "default": "work_sans_n4" },
    { "type": "range", "id": "card_title_size", "label": "Card title size", "min": 14, "max": 32, "step": 1, "unit": "px", "default": 20 },
    { "type": "range", "id": "text_size", "label": "Text size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 17 },
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile card layout",
      "options": [
        { "value": "side", "label": "Image left, text right" },
        { "value": "top", "label": "Image on top, text below" }
      ],
      "default": "top"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "info": "With the image on the left, this is the smallest the image gets; a card with more text still grows. On top and on desktop it is the exact shape.",
      "options": [
        { "value": "fill", "label": "Fill the card height (crops)" },
        { "value": "4 / 3", "label": "Landscape 4:3" },
        { "value": "3 / 2", "label": "Landscape 3:2" },
        { "value": "16 / 9", "label": "Wide 16:9" },
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 5", "label": "Portrait 4:5" },
        { "value": "3 / 4", "label": "Portrait 3:4" }
      ],
      "default": "4 / 3"
    },
    { "type": "range", "id": "image_width", "label": "Image width on mobile", "info": "Only with the image on the left.", "min": 25, "max": 55, "step": 1, "unit": "%", "default": 40 },
    {
      "type": "select",
      "id": "desktop_layout",
      "label": "Desktop layout",
      "options": [
        { "value": "row", "label": "Cards side by side, image on top" },
        { "value": "stack", "label": "Same as mobile, stacked" }
      ],
      "default": "row"
    },
    { "type": "range", "id": "columns", "label": "Cards per row on desktop", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "range", "id": "radius", "label": "Card corner radius", "min": 0, "max": 32, "step": 1, "unit": "px", "default": 8 },
    { "type": "range", "id": "gap", "label": "Space between cards", "min": 8, "max": 40, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "max_width", "label": "Maximum width", "min": 600, "max": 1400, "step": 20, "unit": "px", "default": 1100 },
    { "type": "range", "id": "padding_top", "label": "Space above", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Space below", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "stage",
      "name": "Stage",
      "limit": 6,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_alt", "label": "Image description (alt)" },
        {
          "type": "select",
          "id": "image_focus",
          "label": "Keep in view when cropped",
          "options": [
            { "value": "center", "label": "Middle" },
            { "value": "top", "label": "Top" },
            { "value": "bottom", "label": "Bottom" }
          ],
          "default": "center"
        },
        { "type": "text", "id": "label", "label": "Label", "default": "Stage 1" },
        { "type": "text", "id": "title", "label": "Title", "default": "Early Warning Signs" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Tingling starts in your toes or fingertips. Your feet feel cold or \"off\" for no reason.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Boarage · Stages",
      "blocks": [
        { "type": "stage", "settings": { "label": "Stage 1", "title": "Early Warning Signs" } },
        { "type": "stage", "settings": { "label": "Stage 2", "title": "The Pain Sets In", "text": "<p>The tingling turns to burning. Your feet feel like fire at night. Sleep becomes a battle, numbness creeps in, and your balance starts to feel unreliable.</p>" } },
        { "type": "stage", "settings": { "label": "Stage 3", "title": "Your World Shrinks", "text": "<p>You cannot walk barefoot. You have stopped gardening, traveling, playing with your grandchildren.</p>" } }
      ]
    }
  ]
}
{% endschema %}
