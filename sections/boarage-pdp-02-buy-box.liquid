{%- comment -%}
  Boarage PDP 02 · Buy box (main product). Mobile order, top to bottom:
  gallery carousel (first slide = image + up to 3 benefit tiles, optional round seals) → rating line → title →
  description → benefits box → weight cards → purchase panel (subscription / one-time cards, subscription points
  or 1-/2-/3-month supply cards) → stock line → add-to-cart → note line → trust box with payment icons →
  guarantee box → accordion cards → mobile sticky bar.
  Product setup: one option for the dog's weight (the dose) and one for the supply length (values start with the
  number of months, e.g. "2-month supply"); every weight × supply pair is a variant with its own price.
  Subscription = the weight's 1-month variant with the product's first selling plan.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign form_id = 'bpdp-form-' | append: section.id
  assign cta_default = s.cta_label
  if cta_default == blank
    assign cta_default = 'products.product.add_to_cart' | t
  endif
  assign soldout_label = 'products.product.sold_out' | t
  assign weight_blocks = section.blocks | where: 'type', 'weight'
  assign point_blocks = section.blocks | where: 'type', 'point'
  assign benefit_blocks = section.blocks | where: 'type', 'benefit'
  assign tile_blocks = section.blocks | where: 'type', 'tile'
  assign trust_blocks = section.blocks | where: 'type', 'trust'
  assign note_blocks = section.blocks | where: 'type', 'note'
  assign acc_blocks = section.blocks | where: 'type', 'accordion'
  assign app_blocks = section.blocks | where: 'type', '@app'
  assign benefits_filled = 0
  for block in benefit_blocks
    if block.settings.text != blank or block.settings.lead != blank
      assign benefits_filled = benefits_filled | plus: 1
    endif
  endfor
  assign points_filled = 0
  for block in point_blocks
    if block.settings.text != blank
      assign points_filled = points_filled | plus: 1
    endif
  endfor
  assign tiles_filled = 0
  for block in tile_blocks
    if block.settings.text != blank
      assign tiles_filled = tiles_filled | plus: 1
    endif
  endfor
  assign trust_filled = 0
  for block in trust_blocks
    if block.settings.text != blank
      assign trust_filled = trust_filled | plus: 1
    endif
  endfor
  assign notes_filled = 0
  for block in note_blocks
    if block.settings.text != blank
      assign notes_filled = notes_filled | plus: 1
    endif
  endfor
  assign pay_types = shop.enabled_payment_types

  # Which product option is the dog's weight (wi) and which the supply length (si); -1 = none.
  assign wi = -1
  assign si = -1
  assign wname = s.weight_option | strip | downcase
  assign sname = s.supply_option | strip | downcase
  unless product.has_only_default_variant
    for opt in product.options_with_values
      assign n = opt.name | strip | downcase
      if wname != blank and n == wname
        assign wi = forloop.index0
      elsif sname != blank and n == sname
        assign si = forloop.index0
      endif
    endfor
    if wi == -1 and wname == blank
      for opt in product.options_with_values
        if forloop.index0 != si
          assign wi = forloop.index0
          break
        endif
      endfor
    endif
    if si == -1 and sname == blank
      for opt in product.options_with_values
        if forloop.index0 != wi
          assign si = forloop.index0
          break
        endif
      endfor
    endif
  endunless
  # (read only when the index is >= 0)
  assign w_values = product.options_with_values[wi].values
  assign s_values = product.options_with_values[si].values

  # The 1-month supply value: the first value whose leading number is 1, else the first value.
  assign one = ''
  if si >= 0
    for v in s_values
      assign val = v.name | default: v
      assign mo = val | split: ' ' | first | split: '-' | first | plus: 0
      if mo == 1
        assign one = val
        break
      endif
    endfor
    assign first_s = s_values.first.name | default: s_values.first
    assign one = one | default: first_s
  endif

  # Subscription: the product's first selling plan.
  assign plan = ''
  for grp in product.selling_plan_groups
    assign plan = grp.selling_plans.first
    assign plan_group_name = grp.name
    break
  endfor
  assign has_sub = false
  if plan != blank
    assign has_sub = true
  endif
  assign once_ok = true
  if product.requires_selling_plan
    assign once_ok = false
  endif

  # Selection on load: ?variant= (+ ?selling_plan=) wins, else the first weight, the 1-month supply and the default plan.
  assign cur = product.selected_variant
  assign cur_w = ''
  if wi >= 0
    if cur != blank
      assign cur_w = cur.options[wi]
    else
      assign cur_w = w_values.first.name | default: w_values.first
    endif
  endif
  assign cur_s = one
  if si >= 0 and cur != blank
    assign cur_s = cur.options[si]
  endif
  # A link with ?variant= reopens what it was made from: subscription only with ?selling_plan=.
  assign plan_now = 'once'
  if has_sub
    if once_ok == false
      assign plan_now = 'sub'
      assign cur_s = one
    elsif cur != blank
      if product.selected_selling_plan != blank
        assign plan_now = 'sub'
      endif
    elsif s.default_plan != 'once'
      assign plan_now = 'sub'
    endif
  endif

  # Per-variant subscription price and multi-month saving, kept in lists by variant position.
  assign subs = ''
  assign subs_was = ''
  assign saves = ''
  assign current = ''
  assign base = ''
  assign cur_i = 0
  assign base_i = 0
  for variant in product.variants
    assign vw = ''
    if wi >= 0
      assign vw = variant.options[wi]
    endif
    assign vs = ''
    if si >= 0
      assign vs = variant.options[si]
    endif
    if vw == cur_w and vs == cur_s
      assign current = variant
      assign cur_i = forloop.index0
    endif
    if vw == cur_w and vs == one
      assign base = variant
      assign base_i = forloop.index0
    endif
    assign save = 0
    if si >= 0
      assign mo = vs | split: ' ' | first | split: '-' | first | plus: 0
      if mo > 1
        for b in product.variants
          assign bw = ''
          if wi >= 0
            assign bw = b.options[wi]
          endif
          if bw == vw and b.options[si] == one
            assign full = b.price | times: mo
            if full > variant.price
              assign save = full | minus: variant.price | times: 100.0 | divided_by: full | round
            endif
            break
          endif
        endfor
      endif
    endif
    assign sp = ''
    assign sc = ''
    if has_sub
      for al in variant.selling_plan_allocations
        if al.selling_plan.id == plan.id
          assign sp = al.price | money
          if al.compare_at_price > al.price
            assign sc = al.compare_at_price | money
          endif
          break
        endif
      endfor
    endif
    assign subs = subs | append: sp | append: '^'
    assign subs_was = subs_was | append: sc | append: '^'
    assign saves = saves | append: save | append: '^'
  endfor
  assign subs = subs | split: '^'
  assign subs_was = subs_was | split: '^'
  assign saves = saves | split: '^'
  if current == blank
    assign current = base | default: product.selected_or_first_available_variant
    assign cur_i = base_i
  endif
  if base == blank
    assign base = current
    assign base_i = cur_i
  endif

  assign base_sub = subs[base_i]
  assign current_price_html = current.price | money
  assign current_was_html = ''
  if current.compare_at_price > current.price
    assign current_was_html = current.compare_at_price | money
  endif
  if plan_now == 'sub' and subs[cur_i] != blank
    assign current_price_html = subs[cur_i]
    assign current_was_html = subs_was[cur_i]
  endif

  assign hero_media = current.featured_media | default: product.featured_media
  if hero_media == blank or hero_media.media_type != 'image'
    assign hero_media = product.media | where: 'media_type', 'image' | first
  endif
  assign hero_img = hero_media.preview_image
-%}
{%- if product == blank -%}
  {%- if request.design_mode -%}
    {%- render 'boarage-tokens' -%}
    <div class="bpdp"><div class="bpdp-wrap">{% render 'boarage-placeholder', label: '02 · Buy box: this section needs a product and only works on product templates', kind: 'block' %}</div></div>
  {%- endif -%}
{%- else -%}
  {%- render 'boarage-tokens' -%}
  <div class="bpdp bpdp-buy-root" id="boarage-buy-box" tabindex="-1" data-bpdp-buybox data-bpdp-section="{{ section.id }}" data-bpdp-cta-default="{{ cta_default | escape }}" data-bpdp-soldout="{{ soldout_label | escape }}" data-bpdp-sticky-default="{{ s.sticky_cta_label | escape }}" data-bpdp-after="{{ s.after_add | default: 'drawer' }}" data-bpdp-cart-url="{{ routes.cart_url }}" data-bpdp-error-text="{{ 'sections.cart.cart_error' | t | escape }}" data-bpdp-one="{{ one | escape }}" data-bpdp-save-text="{{ s.supply_badge | escape }}">
    <div class="bpdp-wrap">
      <div class="bpdp-buy">

        {%- render 'boarage-gallery', s: s, product: product, hero_media: hero_media, hero_img: hero_img, tile_blocks: tile_blocks, tiles_filled: tiles_filled -%}

        {%- comment -%} ---------- info column ---------- {%- endcomment -%}
        <div class="bpdp-buy__info">
          {%- if app_blocks.size > 0 -%}
            <div class="bpdp-buy__apps">{%- for block in app_blocks -%}{% render block %}{%- endfor -%}</div>
          {%- elsif s.show_rating -%}
            {%- render 'boarage-rating-line', prefix: s.rating_prefix, word: s.rating_word -%}
          {%- endif -%}

          <h1 class="bpdp-head bpdp-h1">{{ product.title | escape }}</h1>

          {%- if s.description != blank -%}
            <div class="bpdp-desc bpdp-rte">{{ s.description }}</div>
          {%- elsif request.design_mode -%}
            <div class="bpdp-desc">{% render 'boarage-placeholder', label: 'Description under the title' %}</div>
          {%- endif -%}

          {%- if benefits_filled > 0 or request.design_mode -%}
            <ul class="bpdp-benefits bpdp-list">
              {%- for block in benefit_blocks -%}
                {%- if block.settings.text != blank or block.settings.lead != blank or request.design_mode -%}
                  <li {{ block.shopify_attributes }}>
                    {%- render 'boarage-icon', name: 'checkc', size: 24 -%}
                    <span>
                      {%- if block.settings.lead != blank -%}<b>{{ block.settings.lead | escape }}</b>{% if block.settings.text != blank %} – {% endif %}{%- endif -%}
                      {%- if block.settings.text != blank -%}{{ block.settings.text | escape }}{%- elsif block.settings.lead == blank -%}{% render 'boarage-placeholder', label: 'Benefit' %}{%- endif -%}
                    </span>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}

          {%- form 'product', product, id: form_id, class: 'bpdp-form', novalidate: 'novalidate', data-bpdp-form: 'true' -%}
            {%- if s.offer_label != blank -%}
              <p class="bpdp-divider">{{ s.offer_label | escape }}</p>
            {%- elsif request.design_mode -%}
              <p class="bpdp-divider">{% render 'boarage-placeholder', label: 'Offer divider' %}</p>
            {%- endif -%}
            <input type="hidden" name="id" value="{{ current.id }}" data-bpdp-id>
            {%- if has_sub -%}<input type="hidden" name="selling_plan" value="{{ plan.id }}" data-bpdp-plan{% if plan_now != 'sub' %} disabled{% endif %}>{%- endif -%}
            <input type="hidden" name="quantity" value="1">

            {%- render 'boarage-purchase', s: s, product: product, form_id: form_id, wi: wi, si: si, w_values: w_values, s_values: s_values, weight_blocks: weight_blocks, point_blocks: point_blocks, points_filled: points_filled, cur_w: cur_w, cur_s: cur_s, plan_now: plan_now, has_sub: has_sub, once_ok: once_ok, plan_group_name: plan_group_name, base: base, base_sub: base_sub, saves: saves, subs: subs, subs_was: subs_was -%}

            <div class="bpdp-visually-hidden" aria-live="polite" aria-atomic="true">
              <span data-bpdp-price>{{ current_price_html }}</span> <span data-bpdp-was{% if current_was_html == blank %} hidden{% endif %}>{{ current_was_html }}</span>
            </div>
            {%- if s.stock_text != blank -%}
              <p class="bpdp-stock" data-bpdp-stock{% unless current.available %} hidden{% endunless %}><i aria-hidden="true"></i><span>{{ s.stock_text | escape }}</span></p>
            {%- elsif request.design_mode -%}
              <p class="bpdp-stock"><i aria-hidden="true"></i>{% render 'boarage-placeholder', label: 'Stock / delivery line' %}</p>
            {%- endif -%}
            <button type="submit" class="bpdp-btn bpdp-btn--cta" data-bpdp-cta{% unless current.available %} disabled aria-disabled="true"{% endunless %}>
              <span class="bpdp-btn__label" data-bpdp-cta-label>{% if current.available %}{{ cta_default | escape }}{% else %}{{ soldout_label }}{% endif %}</span>
              {%- if s.cta_show_price -%}<span class="bpdp-btn__label" data-bpdp-cta-price{% unless current.available %} hidden{% endunless %}>• {{ current_price_html }}</span>{%- endif -%}
            </button>
            <p class="bpdp-form__error" role="alert" data-bpdp-error hidden></p>
          {%- endform -%}

          {%- if notes_filled > 0 or request.design_mode -%}
            <p class="bpdp-note">
              {%- for block in note_blocks -%}
                {%- if block.settings.text != blank or request.design_mode -%}
                  <span {{ block.shopify_attributes }}>{% render 'boarage-icon', name: block.settings.icon, size: 18 %} {% if block.settings.text != blank %}{{ block.settings.text }}{% else %}{% render 'boarage-placeholder', label: 'Note' %}{% endif %}</span>
                {%- endif -%}
              {%- endfor -%}
            </p>
          {%- endif -%}

          {%- if trust_filled > 0 or s.show_payment_icons or request.design_mode -%}
            <div class="bpdp-trustbox">
              {%- if trust_filled > 0 or request.design_mode -%}
                <ul class="bpdp-trust">
                  {%- for block in trust_blocks -%}
                    {%- if block.settings.text != blank or request.design_mode -%}
                      <li {{ block.shopify_attributes }}>{% render 'boarage-icon', name: block.settings.icon, size: 22 %}<span>{% if block.settings.text != blank %}{{ block.settings.text }}{% else %}{% render 'boarage-placeholder', label: 'Trust line' %}{% endif %}</span></li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}
              {%- if s.show_payment_icons and pay_types.size > 0 -%}
                <div class="bpdp-pay" aria-label="{{ 'sections.footer.payment' | t }}">{%- for type in pay_types -%}{{ type | payment_type_svg_tag }}{%- endfor -%}</div>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if s.show_guarantee -%}{%- render 'boarage-guarantee-box' -%}{%- endif -%}

          {%- if acc_blocks.size > 0 -%}
            <div class="bpdp-accs">
              {%- for block in acc_blocks -%}
                {%- assign acc_id = 'bpdp-acc-' | append: block.id -%}
                {%- render 'boarage-accordion', title: block.settings.title, content: block.settings.content, open: false, id: acc_id, attrs: block.shopify_attributes, title_label: 'Accordion title', content_label: 'Accordion content' -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>

    {%- if s.sticky_bar -%}
      <div class="bpdp-sticky" data-bpdp-sticky hidden>
        <span class="bpdp-sticky__price"><span data-bpdp-sticky-price>{{ current_price_html }}</span><span class="bpdp-sticky__was" data-bpdp-sticky-was{% if current_was_html == blank %} hidden{% endif %}>{{ current_was_html }}</span></span>
        <button type="submit" form="{{ form_id }}" class="bpdp-btn"><span class="bpdp-btn__label" data-bpdp-sticky-label>{% if current.available %}{{ s.sticky_cta_label | default: cta_default | escape }}{% else %}{{ soldout_label }}{% endif %}</span></button>
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:boarage.s02.name",
  "tag": "section",
  "class": "bpdp-section",
  "limit": 1,
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "paragraph", "content": "t:boarage.s02.settings.paragraph" },
    { "type": "header", "content": "t:boarage.s02.settings.gallery_header" },
    {
      "type": "select",
      "id": "gallery_aspect",
      "label": "t:boarage.s02.settings.gallery_aspect.label",
      "options": [
        { "value": "4 / 5", "label": "t:boarage.s02.settings.gallery_aspect.options.portrait" },
        { "value": "1 / 1", "label": "t:boarage.s02.settings.gallery_aspect.options.square" },
        { "value": "3 / 4", "label": "t:boarage.s02.settings.gallery_aspect.options.tall" },
        { "value": "2 / 3", "label": "t:boarage.s02.settings.gallery_aspect.options.taller" }
      ],
      "default": "4 / 5"
    },
    {
      "type": "select",
      "id": "media_fit",
      "label": "t:boarage.s02.settings.media_fit.label",
      "options": [
        { "value": "contain", "label": "t:boarage.s02.settings.media_fit.options.contain" },
        { "value": "cover", "label": "t:boarage.s02.settings.media_fit.options.cover" }
      ],
      "default": "contain"
    },
    { "type": "checkbox", "id": "sticky_gallery", "label": "t:boarage.s02.settings.sticky_gallery.label", "default": true },
    { "type": "checkbox", "id": "show_thumbnails", "label": "t:boarage.s02.settings.show_thumbnails.label", "default": true },
    { "type": "text", "id": "seal_1", "label": "t:boarage.s02.settings.seal_1.label", "info": "t:boarage.s02.settings.seal_1.info" },
    { "type": "text", "id": "seal_2", "label": "t:boarage.s02.settings.seal_2.label" },
    { "type": "header", "content": "t:boarage.s02.settings.text_header" },
    { "type": "checkbox", "id": "show_rating", "label": "t:boarage.s02.settings.show_rating.label", "info": "t:boarage.s02.settings.show_rating.info", "default": true },
    { "type": "text", "id": "rating_prefix", "label": "t:boarage.common.rating_prefix.label", "info": "t:boarage.common.rating_prefix.info" },
    { "type": "text", "id": "rating_word", "label": "t:boarage.common.rating_word.label", "info": "t:boarage.common.rating_word.info" },
    { "type": "richtext", "id": "description", "label": "t:boarage.s02.settings.description.label", "info": "t:boarage.s02.settings.description.info" },
    { "type": "header", "content": "t:boarage.s02.settings.purchase_header" },
    { "type": "paragraph", "content": "t:boarage.s02.settings.purchase_paragraph" },
    { "type": "text", "id": "offer_label", "label": "t:boarage.s02.settings.offer_label.label", "info": "t:boarage.s02.settings.offer_label.info" },
    { "type": "text", "id": "weight_label", "label": "t:boarage.s02.settings.weight_label.label", "info": "t:boarage.s02.settings.weight_label.info" },
    { "type": "text", "id": "weight_option", "label": "t:boarage.s02.settings.weight_option.label", "info": "t:boarage.s02.settings.weight_option.info" },
    { "type": "text", "id": "supply_option", "label": "t:boarage.s02.settings.supply_option.label", "info": "t:boarage.s02.settings.supply_option.info" },
    {
      "type": "select",
      "id": "default_plan",
      "label": "t:boarage.s02.settings.default_plan.label",
      "options": [
        { "value": "sub", "label": "t:boarage.s02.settings.default_plan.options.sub" },
        { "value": "once", "label": "t:boarage.s02.settings.default_plan.options.once" }
      ],
      "default": "sub"
    },
    { "type": "text", "id": "sub_badge", "label": "t:boarage.s02.settings.sub_badge.label", "info": "t:boarage.s02.settings.sub_badge.info" },
    { "type": "text", "id": "sub_label", "label": "t:boarage.s02.settings.sub_label.label", "info": "t:boarage.s02.settings.sub_label.info" },
    { "type": "text", "id": "sub_note", "label": "t:boarage.s02.settings.sub_note.label", "info": "t:boarage.s02.settings.sub_note.info" },
    { "type": "text", "id": "once_label", "label": "t:boarage.s02.settings.once_label.label", "info": "t:boarage.s02.settings.once_label.info" },
    { "type": "text", "id": "once_note", "label": "t:boarage.s02.settings.once_note.label", "info": "t:boarage.s02.settings.once_note.info" },
    { "type": "text", "id": "supply_badge", "label": "t:boarage.s02.settings.supply_badge.label", "info": "t:boarage.s02.settings.supply_badge.info" },
    { "type": "text", "id": "stock_text", "label": "t:boarage.s02.settings.stock_text.label", "info": "t:boarage.s02.settings.stock_text.info" },
    { "type": "header", "content": "t:boarage.s02.settings.buttons_header" },
    { "type": "text", "id": "cta_label", "label": "t:boarage.s02.settings.cta_label.label", "info": "t:boarage.s02.settings.cta_label.info" },
    { "type": "checkbox", "id": "cta_show_price", "label": "t:boarage.s02.settings.cta_show_price.label", "default": true },
    {
      "type": "select",
      "id": "after_add",
      "label": "t:boarage.s02.settings.after_add.label",
      "options": [
        { "value": "drawer", "label": "t:boarage.s02.settings.after_add.options.drawer" },
        { "value": "cart", "label": "t:boarage.s02.settings.after_add.options.cart" }
      ],
      "default": "drawer"
    },
    { "type": "checkbox", "id": "show_payment_icons", "label": "t:boarage.s02.settings.show_payment_icons.label", "info": "t:boarage.s02.settings.show_payment_icons.info", "default": true },
    { "type": "checkbox", "id": "show_guarantee", "label": "t:boarage.common.show_guarantee.label", "info": "t:boarage.common.show_guarantee.info", "default": true },
    { "type": "checkbox", "id": "sticky_bar", "label": "t:boarage.s02.settings.sticky_bar.label", "default": true },
    { "type": "text", "id": "sticky_cta_label", "label": "t:boarage.s02.settings.sticky_cta_label.label", "info": "t:boarage.s02.settings.sticky_cta_label.info" }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "tile",
      "name": "t:boarage.s02.blocks.tile.name",
      "limit": 3,
      "settings": [
        { "type": "paragraph", "content": "t:boarage.s02.blocks.tile.paragraph" },
        {
          "type": "select",
          "id": "icon",
          "label": "t:boarage.common.icon.label",
          "options": [
            { "value": "snowflake", "label": "t:boarage.icons.snowflake" },
            { "value": "flame", "label": "t:boarage.icons.flame" },
            { "value": "muscle", "label": "t:boarage.icons.muscle" },
            { "value": "bone", "label": "t:boarage.icons.bone" },
            { "value": "bolt", "label": "t:boarage.icons.bolt" },
