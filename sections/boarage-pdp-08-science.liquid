{%- comment -%}
  Boarage PDP 08 · Science: eyebrow, headline, paragraph and an illustrative two-curve chart
  (labels come from settings; the curves carry no numbers) or an image instead.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign has_content = false
  if s.heading != blank or s.text != blank or s.eyebrow != blank or s.image != blank
    assign has_content = true
  endif
  assign visual = s.visual | default: 'chart'
-%}
{%- if has_content or request.design_mode -%}
  {%- render 'boarage-tokens' -%}
  <div class="bpdp bpdp-sec">
    <div class="bpdp-wrap bpdp-sci">
      <div class="bpdp-stack">
        {%- render 'boarage-section-head', eyebrow: s.eyebrow, caps: true, heading: s.heading, intro: s.text, eyebrow_label: 'Eyebrow', heading_label: '08 · Science headline', intro_label: 'Paragraph' -%}
      </div>
      {%- if visual == 'chart' -%}
        <figure class="bpdp-chart-wrap">
          <svg class="bpdp-chart" viewBox="0 0 400 300" role="img"{% if s.chart_alt != blank %} aria-label="{{ s.chart_alt | escape }}"{% else %} aria-hidden="true"{% endif %}>
            <path class="f1" d="M48 60C130 140 210 190 372 198L372 252L48 252Z"/>
            <path d="M48 20V252H372" fill="none" stroke="currentColor" stroke-width="1.2" opacity=".55"/>
            <path class="c1" d="M48 60C130 140 210 190 372 198" fill="none" stroke-width="2.4" stroke-linecap="round"/>
            <path class="c2" d="M48 60C120 175 220 236 372 250" fill="none" stroke-width="2.4" stroke-linecap="round"/>
            {%- if s.line_1 != blank -%}<rect x="210" y="34" width="9" height="9" rx="1.5" fill="var(--bpdp-cta)"/><text x="226" y="43">{{ s.line_1 | escape }}</text>{%- endif -%}
            {%- if s.line_2 != blank -%}<rect x="210" y="56" width="9" height="9" rx="1.5" fill="var(--bpdp-red)"/><text x="226" y="65">{{ s.line_2 | escape }}</text>{%- endif -%}
            {%- if s.axis_y != blank -%}<text x="22" y="140" transform="rotate(-90 22 140)" text-anchor="middle">{{ s.axis_y | escape }}</text>{%- endif -%}
            {%- if s.axis_x != blank -%}<text x="210" y="284" text-anchor="middle">{{ s.axis_x | escape }}</text>{%- endif -%}
          </svg>
          {%- if request.design_mode and s.line_1 == blank and s.line_2 == blank -%}<figcaption>{% render 'boarage-placeholder', label: 'Chart legend labels' %}</figcaption>{%- endif -%}
        </figure>
      {%- elsif s.image != blank -%}
        <div class="bpdp-sci__img">{{ s.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1200', sizes: '(min-width: 900px) 50vw, 100vw', alt: s.image_alt }}</div>
      {%- elsif request.design_mode -%}
        <div>{% render 'boarage-placeholder', label: 'Image', kind: 'block' %}</div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:boarage.s08.name",
  "tag": "section",
  "class": "bpdp-section",
  "enabled_on": { "templates": ["*"] },
  "settings": [
    { "type": "paragraph", "content": "t:boarage.s08.settings.paragraph" },
    { "type": "text", "id": "eyebrow", "label": "t:boarage.common.eyebrow.label" },
    { "type": "inline_richtext", "id": "heading", "label": "t:boarage.common.heading.label" },
    { "type": "richtext", "id": "text", "label": "t:boarage.common.text.label" },
    {
      "type": "select",
      "id": "visual",
      "label": "t:boarage.s08.settings.visual.label",
      "options": [
        { "value": "chart", "label": "t:boarage.s08.settings.visual.options.chart" },
        { "value": "image", "label": "t:boarage.s08.settings.visual.options.image" }
      ],
      "default": "chart"
    },
    { "type": "text", "id": "line_1", "label": "t:boarage.s08.settings.line_1.label", "info": "t:boarage.s08.settings.line_1.info" },
    { "type": "text", "id": "line_2", "label": "t:boarage.s08.settings.line_2.label", "info": "t:boarage.s08.settings.line_2.info" },
    { "type": "text", "id": "axis_y", "label": "t:boarage.s08.settings.axis_y.label" },
    { "type": "text", "id": "axis_x", "label": "t:boarage.s08.settings.axis_x.label" },
    { "type": "text", "id": "chart_alt", "label": "t:boarage.s08.settings.chart_alt.label", "info": "t:boarage.s08.settings.chart_alt.info" },
    { "type": "image_picker", "id": "image", "label": "t:boarage.common.image.label" },
    { "type": "text", "id": "image_alt", "label": "t:boarage.common.image_alt.label" }
  ],
  "presets": [{ "name": "t:boarage.s08.name" }]
}
{% endschema %}
