{%- comment -%}
  Benefit bullets in a soft green box: check-square icon, "Lead - text" per line.
  Self-contained (own CSS). Rendered by blocks/boarage-bullets.liquid or from a "Custom Liquid" block:

    {% capture items %}
    Mitochondria - Reactivated to support nerve repair
    Nerve Pain - Helps reduce burning, tingling, numbness
    {% endcapture %}
    {% render 'boarage-bullets', items: items, icon_color: '#2fbd44' %}

  Params (all optional):
    items        one bullet per line; the part before the first " - " (or " – ") is the lead, the rest the text
    icon         'check-square' (default) | 'check-circle' | 'check'      icon_size px (22)   icon_color (#2fbd44)
    box_color    box background (#eef7f1); 'transparent' for none          radius px (8)       padding px (24)
    lead_color   (#1d4d36)   lead_weight (500)   text_color (#1d4d36)   text_weight (400)   separator shown between lead and text (' - ')
    font_family  CSS font-family (default the theme body font)   font_size px (18)   line_height (1.35)   gap px between bullets (18)
    max_width    px of the box, 0 = none (0)   align 'left' | 'center' (box placement, text stays left)
    margin_top   px of space above the root element (0)   margin_bottom  px of space below (0)
    attrs        extra attributes on the root element (block.shopify_attributes)
{%- endcomment -%}
{%- liquid
  assign margin_top = margin_top | default: 0
  assign margin_bottom = margin_bottom | default: 0
  assign icon = icon | default: 'check-square'
  assign icon_size = icon_size | default: 22
  assign icon_color = icon_color | default: '#2fbd44'
  assign box_color = box_color | default: '#eef7f1'
  assign radius = radius | default: 8
  assign padding = padding | default: 24
  assign lead_color = lead_color | default: '#1d4d36'
  assign lead_weight = lead_weight | default: 500
  assign text_color = text_color | default: '#1d4d36'
  assign text_weight = text_weight | default: 400
  if separator == nil
    assign separator = ' - '
  endif
  assign font_family = font_family | default: 'var(--font-body-family, system-ui, sans-serif)'
  assign font_size = font_size | default: 18
  assign line_height = line_height | default: 1.35
  assign gap = gap | default: 18
  assign max_width = max_width | default: 0 | plus: 0
  assign align = align | default: 'left'

  assign lines = items | default: '' | newline_to_br | split: '<br />'
  assign filled = 0
  for line in lines
    assign l = line | strip_html | strip
    if l != blank
      assign filled = filled | plus: 1
    endif
  endfor
-%}
{%- if filled > 0 -%}
{%- style -%}
  .bbl { box-sizing: border-box; margin: var(--bbl-mt, 0) 0 var(--bbl-mb, 0); padding: var(--bbl-pad, 24px); list-style: none; background: var(--bbl-box, #eef7f1); border-radius: var(--bbl-radius, 8px); max-width: var(--bbl-max, none); font-family: var(--bbl-font); font-size: var(--bbl-size, 18px); line-height: var(--bbl-line, 1.35); color: var(--bbl-text, #1d4d36); font-weight: var(--bbl-text-weight, 400); text-align: left; -webkit-font-smoothing: antialiased; }
  .bbl--center { margin-left: auto; margin-right: auto; }
  .bbl__item { display: flex; align-items: flex-start; gap: .65em; margin: 0; padding: 0; }
  .bbl__item + .bbl__item { margin-top: var(--bbl-gap, 18px); }
  .bbl__icon { flex: none; width: var(--bbl-icon, 22px); height: var(--bbl-icon, 22px); margin-top: calc((1em * var(--bbl-line, 1.35) - var(--bbl-icon, 22px)) / 2); color: var(--bbl-icon-color, #2fbd44); }
  .bbl__icon svg { display: block; width: 100%; height: 100%; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .bbl__lead { font-weight: var(--bbl-lead-weight, 500); color: var(--bbl-lead, #1d4d36); }
{%- endstyle -%}
{%- capture svg -%}
  {%- case icon -%}
    {%- when 'check-circle' -%}
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10"/><path d="M8 12.5l2.7 2.7L16.5 9"/></svg>
    {%- when 'check' -%}
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 12.5l5 5L20 6.5"/></svg>
    {%- else -%}
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20 12v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h9"/><path d="M8 12l3.5 3.5L21 6"/></svg>
  {%- endcase -%}
{%- endcapture -%}
<ul class="bbl bbl--{{ align }}" style="--bbl-mt: {{ margin_top }}px; --bbl-mb: {{ margin_bottom }}px; --bbl-pad: {{ padding }}px; --bbl-box: {{ box_color }}; --bbl-radius: {{ radius }}px; --bbl-max: {% if max_width > 0 %}{{ max_width }}px{% else %}none{% endif %}; --bbl-font: {{ font_family }}; --bbl-size: {{ font_size }}px; --bbl-line: {{ line_height }}; --bbl-gap: {{ gap }}px; --bbl-icon: {{ icon_size }}px; --bbl-icon-color: {{ icon_color }}; --bbl-lead: {{ lead_color }}; --bbl-lead-weight: {{ lead_weight }}; --bbl-text: {{ text_color }}; --bbl-text-weight: {{ text_weight }};" {{ attrs }}>
  {%- for line in lines -%}
    {%- liquid
      assign l = line | strip_html | strip
      if l == blank
        continue
      endif
      assign lead = ''
      assign rest = l
      if l contains ' - '
        assign parts = l | split: ' - '
        assign lead = parts[0]
        assign rest = l | remove_first: lead | remove_first: ' - '
      elsif l contains ' – '
        assign parts = l | split: ' – '
        assign lead = parts[0]
        assign rest = l | remove_first: lead | remove_first: ' – '
      endif
    -%}
    <li class="bbl__item">
      <span class="bbl__icon">{{ svg }}</span>
      <span>{% if lead != blank %}<span class="bbl__lead">{{ lead | strip | escape }}</span>{{ separator | escape }}{% endif %}{{ rest | strip | escape }}</span>
    </li>
  {%- endfor -%}
</ul>
{%- endif -%}
