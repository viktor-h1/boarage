{%- comment -%}
  Inline SVG icon set (24 x 24, stroke = currentColor). Params: name, size (px, default 24), class.
  Usage: {% render 'boarage-icon', name: 'checksq', size: 22 %}
{%- endcomment -%}
{%- liquid
  assign px = size | default: 24
  assign fill = 'none'
  case name
    when 'checksq'
      assign d = '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="m8 12.5 3 3 6.5-7.5"/>'
    when 'xsq'
      assign d = '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="m8.5 8.5 7 7m0-7-7 7"/>'
    when 'check'
      assign d = '<path d="m5 12.5 4.5 4.5L19 7"/>'
    when 'plus'
      assign d = '<path d="M12 5v14M5 12h14"/>'
    when 'chevron-left'
      assign d = '<path d="m15 5-7 7 7 7"/>'
    when 'chevron-right'
      assign d = '<path d="m9 5 7 7-7 7"/>'
    when 'chevron'
      assign d = '<path d="m6 9 6 6 6-6"/>'
    when 'shield'
      assign fill = 'currentColor'
      assign d = '<path d="M12 2 4 5v6c0 5.5 3.4 9.8 8 11 4.6-1.2 8-5.5 8-11V5l-8-3Z" stroke="none"/><path d="m8.5 12 2.5 2.5 4.5-5" stroke="var(--bpdp-shield-ink, #fff)" stroke-width="2"/>'
    when 'star'
      assign fill = 'currentColor'
      assign d = '<path d="m12 2.5 2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4 6.1 20.5l1.2-6.5L2.5 9.4l6.6-.9Z" stroke="none"/>'
    when 'refresh'
      assign d = '<path d="M20 12a8 8 0 1 1-2.3-5.7M20 4v5h-5"/>'
    when 'clock'
      assign d = '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>'
    when 'truck'
      assign d = '<path d="M3 6h11v10H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/>'
    when 'box'
      assign d = '<path d="m12 3 9 4.5v9L12 21l-9-4.5v-9L12 3Zm0 9 9-4.5M12 12v9m0-9L3 7.5"/>'
    when 'lock'
      assign d = '<rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>'
    when 'chat'
      assign d = '<path d="M4 5h16v11H9l-5 4V5Z"/>'
    when 'invoice'
      assign d = '<path d="M6 3h12v18l-3-2-3 2-3-2-3 2V3Z"/><path d="M9 8h6M9 12h6"/>'
    when 'leaf'
      assign d = '<path d="M5 19C5 9 11 5 20 5c0 9-4 15-14 15-.5 0-1-.5-1-1Z"/><path d="M5 19c3-5 7-8 10-10"/>'
    when 'drop'
      assign d = '<path d="M12 3s7 7.5 7 12a7 7 0 0 1-14 0c0-4.5 7-12 7-12Z"/>'
    when 'snowflake'
      assign d = '<path d="M12 2v20M2 12h20M4.9 4.9l14.2 14.2M19.1 4.9 4.9 19.1"/>'
    when 'flame'
      assign d = '<path d="M12 22c4 0 7-3 7-7 0-3-2-5-3-7-1 2-2 3-3 3 0-3-1-6-4-8 0 4-4 6-4 12a7 7 0 0 0 7 7Z"/>'
    when 'wave'
      assign d = '<path d="M2 14c3-4 5-4 8 0s5 4 8 0M2 8c3-4 5-4 8 0s5 4 8 0"/>'
    when 'hand'
      assign d = '<path d="M8 11V5a1.5 1.5 0 0 1 3 0v6M11 10V4a1.5 1.5 0 0 1 3 0v7M14 11V6a1.5 1.5 0 0 1 3 0v7M17 12a1.5 1.5 0 0 1 3 0v3a7 7 0 0 1-14 0v-2l-2-3a1.5 1.5 0 0 1 2.4-1.8L8 10"/>'
    when 'heart'
      assign d = '<path d="M12 21s-8-5.5-8-11.5A4.5 4.5 0 0 1 12 7a4.5 4.5 0 0 1 8 2.5C20 15.5 12 21 12 21Z"/>'
    when 'jar'
      assign d = '<path d="M6 9h12v10a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V9ZM8 4h8v5H8z"/>'
    when 'bolt'
      assign d = '<path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z"/>'
    when 'moon'
      assign d = '<path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/>'
    when 'plant'
      assign d = '<path d="M12 22v-8M12 14c0-4 3-7 8-7 0 4-3 7-8 7ZM12 14c0-3-2.5-5.5-6-5.5 0 3 2.5 5.5 6 5.5Z"/>'
    when 'shoe'
      assign d = '<path d="M2 15h20v3H2zM2 15c0-3 2-6 4-6l3 2 3-3 4 4 6 3"/>'
    when 'muscle'
      assign d = '<path d="M6 20c-2-3-2-7 1-9l2-5h5l1 3 4 1-1 4c2 1 3 3 2 6H6Z"/>'
    when 'sun'
      assign d = '<circle cx="12" cy="12" r="4"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M4.9 19.1 7 17M17 7l2.1-2.1"/>'
    when 'user'
      assign d = '<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>'
    when 'cell'
      assign d = '<ellipse cx="12" cy="12" rx="9" ry="5.5"/><path d="M7 12c1-2 2-2 3 0s2 2 3 0 2-2 3 0"/>'
    when 'info'
      assign d = '<circle cx="12" cy="12" r="9"/><path d="M12 8h.01M12 11v5"/>'
    when 'bone'
      assign d = '<path d="M7 5a2 2 0 0 1 2 2l6 6a2 2 0 1 1 2 2 2 2 0 1 1-2 2l-6-6a2 2 0 1 1-2-2 2 2 0 1 1 0-4Z"/>'
    else
      assign d = '<path d="m5 12.5 4.5 4.5L19 7"/>'
  endcase
-%}
<svg class="bpdp-i{% if class != blank %} {{ class }}{% endif %}" width="{{ px }}" height="{{ px }}" viewBox="0 0 24 24" fill="{{ fill }}" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">{{ d }}</svg>
