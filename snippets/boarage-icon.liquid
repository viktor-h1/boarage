{%- comment -%}
  Inline SVG icon set. Params: name (see the case list), size (px, default 24), class.
  Icons are decorative (aria-hidden); give meaning with visible text next to them.
{%- endcomment -%}
{%- liquid
  assign icon_size = size | default: 24
-%}
<svg class="bpdp-icon{% if class != blank %} {{ class }}{% endif %}" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'shield' -%}<path d="M12 3l7 3v5c0 5-3.5 8.5-7 10-3.5-1.5-7-5-7-10V6z"/><path d="M9 12l2 2 4-4"/>
    {%- when 'box' -%}<path d="M3 7l9-4 9 4v10l-9 4-9-4z"/><path d="M3 7l9 4 9-4M12 11v10"/>
    {%- when 'truck' -%}<path d="M3 6h11v9H3zM14 9h4l3 3v3h-7z"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/>
    {%- when 'chat' -%}<path d="M4 5h16v11H8l-4 4z"/>
    {%- when 'invoice' -%}<path d="M6 3h12v18l-3-2-3 2-3-2-3 2z"/><path d="M9 8h6M9 12h6"/>
    {%- when 'lock' -%}<rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>
    {%- when 'leaf' -%}<path d="M5 19C5 9 12 4 20 4c0 8-5 15-15 15z"/><path d="M5 19c3-5 7-8 11-10"/>
    {%- when 'drop' -%}<path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11z"/>
    {%- when 'snowflake' -%}<path d="M12 3v18M3 12h18M6 6l12 12M18 6L6 18"/>
    {%- when 'flame' -%}<path d="M12 22c4 0 7-3 7-7 0-4-3-6-4-9-1 2-2 3-3 3 0-2-1-4-3-6-1 4-4 6-4 12 0 4 3 7 7 7z"/>
    {%- when 'wave' -%}<path d="M3 12c3-4 6-4 9 0s6 4 9 0"/>
    {%- when 'hand' -%}<path d="M8 13V5a2 2 0 0 1 4 0v6M12 11V4a2 2 0 0 1 4 0v7M16 11V6a2 2 0 0 1 4 0v8a7 7 0 0 1-7 7h-1a7 7 0 0 1-6-3.5L3.5 14a2 2 0 0 1 3.5-2l1 1.5"/>
    {%- when 'heart' -%}<path d="M12 21s-7-4.5-9-9a5 5 0 0 1 9-3 5 5 0 0 1 9 3c-2 4.5-9 9-9 9z"/>
    {%- when 'jar' -%}<path d="M8 4h8v3H8zM7 7h10M7 7v12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V7"/>
    {%- when 'clock' -%}<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
    {%- when 'star' -%}<path d="M12 3l2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17.5 6.3 20.5l1.2-6.4L2.8 9.7l6.4-.8z"/>
    {%- when 'check' -%}<path d="M5 12l5 5L20 7"/>
    {%- when 'x' -%}<path d="M6 6l12 12M18 6L6 18"/>
    {%- when 'minus' -%}<path d="M5 12h14"/>
    {%- when 'plus' -%}<path d="M12 5v14M5 12h14"/>
    {%- when 'chevron' -%}<path d="M6 9l6 6 6-6"/>
    {%- when 'info' -%}<circle cx="12" cy="12" r="9"/><path d="M12 8h.01M11 12h1v4h1"/>
    {%- else -%}<circle cx="12" cy="12" r="9"/>
  {%- endcase -%}
</svg>
