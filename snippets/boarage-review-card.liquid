{%- comment -%}
  One manual review card (<li>). Params: title, text, name, meta, date, rating (1-5), image, image_alt,
  attrs (block.shopify_attributes), hidden (boolean, for "load more"), labels for the editor placeholders.
  Storefront: renders only when text is filled. Editor: always renders, with placeholders.
{%- endcomment -%}
{%- if text != blank or request.design_mode -%}
  <li class="bpdp-rev" {{ attrs }}{% if hidden %} hidden data-bpdp-hidden{% endif %}>
    {%- if title != blank -%}<h3 class="bpdp-rev__title">{{ title | escape }}</h3>{%- endif -%}
    {%- capture star_label -%}{{ 'accessibility.star_reviews_info' | t: rating_value: rating, rating_max: 5 }}{%- endcapture -%}
    <p class="bpdp-rating">{% render 'boarage-stars', rating: rating, size: 'sm', label: star_label %}<b>{{ rating | default: 5 }}/5</b></p>
    <div class="bpdp-rev__text">{% if text != blank %}{{ text | escape | newline_to_br }}{% else %}{% render 'boarage-placeholder', label: 'Review text' %}{% endif %}</div>
    {%- if name != blank or meta != blank or date != blank or request.design_mode -%}
      <div class="bpdp-rev__foot">
        {%- if image != blank -%}{{ image | image_url: width: 88 | image_tag: loading: 'lazy', alt: image_alt, width: 44, height: 44 }}{%- endif -%}
        <span class="bpdp-rev__name">{% if name != blank %}{{ name | escape }}{% elsif request.design_mode %}{% render 'boarage-placeholder', label: 'Name' %}{% endif %}</span>
        {%- if meta != blank -%}<span class="bpdp-rev__meta">{{ meta | escape }}</span>{%- endif -%}
        {%- if date != blank -%}<span class="bpdp-rev__date">{{ date | escape }}</span>{%- endif -%}
      </div>
    {%- endif -%}
  </li>
{%- endif -%}
