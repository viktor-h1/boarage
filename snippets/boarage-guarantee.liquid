{%- comment -%}
  Guarantee card: soft green box with a thin border, shield icon + bold title on one line, regular text below.
  Self-contained (own CSS). Rendered by blocks/boarage-guarantee.liquid or from a "Custom Liquid" block:

    {% render 'boarage-guarantee', title: '90-Day Money Back Guarantee', text: 'Love your results within 90 days or get 100% of your money back, no questions asked.' %}

  Params (all optional):
    title        heading text (default '90-Day Money Back Guarantee')     text   body, HTML from a richtext setting or plain text
    icon         'shield-check' (default) | 'shield' | 'check-circle' | 'none'   icon_color (#1d4d36)   icon_size px (26)
    box_color    background (#eef7f1)   border_color (#9fd3b4)   border_width px (1)   radius px (8)   padding px (20)
    title_color  (#1d4d36)   title_weight (700)   title_size px (22)   title_font  CSS font-family (default the theme heading font)
    text_color   (#1d4d36)   text_weight  (400)   text_size  px (18)   text_font   CSS font-family (default the theme body font)
    line_height  (1.4)   gap px between title and text (10)   max_width px, 0 = none (0)   align 'left' | 'center'
    attrs        extra attributes on the root element (block.shopify_attributes)
{%- endcomment -%}
{%- liquid
  if title == nil
    assign title = '90-Day Money Back Guarantee'
  endif
  assign icon = icon | default: 'shield-check'
  assign icon_color = icon_color | default: '#1d4d36'
  assign icon_size = icon_size | default: 26
  assign box_color = box_color | default: '#eef7f1'
  assign border_color = border_color | default: '#9fd3b4'
  assign border_width = border_width | default: 1
  assign radius = radius | default: 8
  assign padding = padding | default: 20
  assign title_color = title_color | default: '#1d4d36'
  assign title_weight = title_weight | default: 700
  assign title_size = title_size | default: 22
  assign title_font = title_font | default: 'var(--font-heading-family, system-ui, sans-serif)'
  assign text_color = text_color | default: '#1d4d36'
  assign text_weight = text_weight | default: 400
  assign text_size = text_size | default: 18
  assign text_font = text_font | default: 'var(--font-body-family, system-ui, sans-serif)'
  assign line_height = line_height | default: 1.4
  assign gap = gap | default: 10
  assign max_width = max_width | default: 0 | plus: 0
  assign align = align | default: 'left'
  assign has_text = false
  if text != blank
    assign plain = text | strip_html | strip
    if plain != blank
      assign has_text = true
    endif
  endif
-%}
{%- if title != blank or has_text -%}
{%- style -%}
  .bgt { box-sizing: border-box; margin: 0; padding: var(--bgt-pad, 20px); background: var(--bgt-box, #eef7f1); border: var(--bgt-border-w, 1px) solid var(--bgt-border, #9fd3b4); border-radius: var(--bgt-radius, 8px); max-width: var(--bgt-max, none); text-align: left; line-height: var(--bgt-line, 1.4); -webkit-font-smoothing: antialiased; }
  .bgt--center { margin-left: auto; margin-right: auto; }
  .bgt__head { display: flex; align-items: center; gap: .5em; margin: 0; padding: 0; font-family: var(--bgt-title-font); font-size: var(--bgt-title-size, 22px); font-weight: var(--bgt-title-weight, 700); line-height: 1.2; color: var(--bgt-title, #1d4d36); letter-spacing: -.01em; }
  .bgt__icon { flex: none; width: var(--bgt-icon, 26px); height: var(--bgt-icon, 26px); color: var(--bgt-icon-color, #1d4d36); }
  .bgt__icon svg { display: block; width: 100%; height: 100%; }
  .bgt__text { margin: var(--bgt-gap, 10px) 0 0; padding: 0; font-family: var(--bgt-text-font); font-size: var(--bgt-text-size, 18px); font-weight: var(--bgt-text-weight, 400); color: var(--bgt-text, #1d4d36); }
  .bgt__text p { margin: 0; }
  .bgt__text p + p { margin-top: .5em; }
  .bgt__text a { color: inherit; text-decoration: underline; text-underline-offset: .15em; }
{%- endstyle -%}
{%- capture svg -%}
  {%- case icon -%}
    {%- when 'shield' -%}
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="currentColor"><path d="M12 1.8l8 3.2v6.4c0 5-3.4 9.3-8 10.8-4.6-1.5-8-5.8-8-10.8V5z"/></svg>
    {%- when 'check-circle' -%}
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="currentColor"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm-1.4 14.4l-4-4 1.7-1.7 2.3 2.3 5.3-5.3 1.7 1.7z"/></svg>
    {%- when 'none' -%}
    {%- else -%}
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="currentColor"><path fill-rule="evenodd" d="M12 1.8l8 3.2v6.4c0 5-3.4 9.3-8 10.8-4.6-1.5-8-5.8-8-10.8V5zm-1.3 13.9l6-6-1.7-1.7-4.3 4.3-2-2L7 12z"/></svg>
  {%- endcase -%}
{%- endcapture -%}
<div class="bgt bgt--{{ align }}" style="--bgt-pad: {{ padding }}px; --bgt-box: {{ box_color }}; --bgt-border: {{ border_color }}; --bgt-border-w: {{ border_width }}px; --bgt-radius: {{ radius }}px; --bgt-max: {% if max_width > 0 %}{{ max_width }}px{% else %}none{% endif %}; --bgt-line: {{ line_height }}; --bgt-title-font: {{ title_font }}; --bgt-title-size: {{ title_size }}px; --bgt-title-weight: {{ title_weight }}; --bgt-title: {{ title_color }}; --bgt-icon: {{ icon_size }}px; --bgt-icon-color: {{ icon_color }}; --bgt-text-font: {{ text_font }}; --bgt-text-size: {{ text_size }}px; --bgt-text-weight: {{ text_weight }}; --bgt-text: {{ text_color }}; --bgt-gap: {{ gap }}px;" {{ attrs }}>
  {%- if title != blank -%}
    <p class="bgt__head">{% if svg != blank %}<span class="bgt__icon">{{ svg }}</span>{% endif %}<span>{{ title | escape }}</span></p>
  {%- endif -%}
  {%- if has_text -%}
    <div class="bgt__text">{% if text contains '<p' or text contains '<div' %}{{ text }}{% else %}<p>{{ text }}</p>{% endif %}</div>
  {%- endif -%}
</div>
{%- endif -%}
