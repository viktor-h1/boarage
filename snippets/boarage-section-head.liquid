{%- comment -%}
  Section header: optional eyebrow, heading (inline rich text: *italic* renders as the green highlight), intro.
  Params: eyebrow, caps (uppercase eyebrow), heading, intro (richtext HTML), heading_label, intro_label,
  eyebrow_label, align ('center' or blank), tag (heading tag, default h2).
{%- endcomment -%}
{%- assign htag = tag | default: 'h2' -%}
{%- if heading != blank or intro != blank or eyebrow != blank or request.design_mode -%}
  <div class="bpdp-shead{% if align == 'center' %} bpdp-center{% endif %}">
    {%- if eyebrow != blank -%}
      <span class="bpdp-eyebrow{% if caps %} bpdp-eyebrow--caps{% endif %}">{{ eyebrow | escape }}</span>
    {%- elsif request.design_mode and eyebrow_label != blank -%}
      <span class="bpdp-eyebrow">{% render 'boarage-placeholder', label: eyebrow_label %}</span>
    {%- endif -%}
    {%- if heading != blank -%}
      <{{ htag }} class="bpdp-head bpdp-h2">{{ heading }}</{{ htag }}>
    {%- elsif request.design_mode and heading_label != blank -%}
      <p class="bpdp-head bpdp-h2">{% render 'boarage-placeholder', label: heading_label %}</p>
    {%- endif -%}
    {%- if intro != blank -%}
      <div class="bpdp-rte bpdp-shead__intro">{{ intro }}</div>
    {%- elsif request.design_mode and intro_label != blank -%}
      <div class="bpdp-shead__intro">{% render 'boarage-placeholder', label: intro_label %}</div>
    {%- endif -%}
  </div>
{%- endif -%}
