    { "type": "color", "id": "text_color", "label": "Colour", "default": "#1d4d36" },
    {
      "type": "select",
      "id": "text_font_source",
      "label": "Font",
      "options": [
        { "value": "body", "label": "Theme body font" },
        { "value": "heading", "label": "Theme heading font" },
        { "value": "custom", "label": "Custom (picker below)" }
      ],
      "default": "body"
    },
    { "type": "font_picker", "id": "text_font", "label": "Custom font", "default": "work_sans_n4" },
    { "type": "range", "id": "text_size", "label": "Size", "min": 12, "max": 26, "step": 1, "unit": "px", "default": 17 },
    {
      "type": "select",
      "id": "text_weight",
      "label": "Weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" }
      ],
      "default": "400"
