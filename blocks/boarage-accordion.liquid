    { "type": "range", "id": "line_height", "label": "Line height", "min": 120, "max": 190, "step": 5, "unit": "%", "default": 150 },
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "align",
      "label": "Placement",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    { "type": "range", "id": "max_width", "label": "Maximum width", "info": "0 = full width of the column.", "min": 0, "max": 900, "step": 20, "unit": "px", "default": 0 }
  ],
  "presets": [{ "name": "Accordion" }]
}
{% endschema %}
