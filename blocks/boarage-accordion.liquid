        { "value": "custom", "label": "Custom (picker below)" }
      ],
      "default": "body"
    },
    { "type": "font_picker", "id": "title_font", "label": "Custom font", "default": "work_sans_n6" },
    { "type": "range", "id": "title_size", "label": "Size", "min": 14, "max": 30, "step": 1, "unit": "px", "default": 19 },
    {
